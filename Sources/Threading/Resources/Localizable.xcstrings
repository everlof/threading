    "Live capacity, observed limit history, cost, tokens, and provider coverage.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Aktuell kapacitet, observerad gränshistorik, kostnad, token och leverantörstäckning."}}}},
    "Next reset in %@": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Nästa återställning om %@"}}}},
