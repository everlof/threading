    "Events shown as Silent make no sound anywhere unless given one here — the group and one-click choices never turn them on." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händelser som visas som Tyst ger inget ljud någonstans om de inte får ett här — grupp- och ettklicksvalen slår aldrig på dem."
          }
        }
      }
    },
