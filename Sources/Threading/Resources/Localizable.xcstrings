      }
    },
    "Native Finder artwork under System; semantic, theme-owned file kinds under authored themes.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Inbyggd Finder-grafik med System; semantiska, temaägda filtyper med skapade teman." } }
