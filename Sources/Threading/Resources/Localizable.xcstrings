    "Old version": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Tidigare version"}}}},
    "Searches the files changed in the active Git Review.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Söker bland filerna som ändrats i den aktiva Git-granskningen."}}}},
    "Show a Git Review with changed files first.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Visa först en Git-granskning med ändrade filer."}}}},
    "Show changed files": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Visa ändrade filer"}}}},
    "Show earlier unmodified lines": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Visa tidigare oförändrade rader"}}}},
    "Show later unmodified lines": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Visa senare oförändrade rader"}}}},
    "Switch to split diff": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Växla till delad diff"}}}},
    "Switch to unified diff": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Växla till enhetlig diff"}}}},
    "Decrease diff text size": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Minska textstorleken i diffen"}}}},
