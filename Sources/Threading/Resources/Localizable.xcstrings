          }
        }
      }
    },
    "Adds Threading's entries to each Codex account's hooks.json, so sessions show exact activity instead of guessing from output. Your existing entries are kept.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till Threadings poster i varje Codex-kontos hooks.json, så att konversationer visar exakt aktivitet i stället för att uppskatta den från utdata. Dina befintliga poster behålls."
          }
        }
