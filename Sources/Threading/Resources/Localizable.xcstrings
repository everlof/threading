    },
    "Starts automatically after the usage window resets · expected %@": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Startar automatiskt när användningsfönstret återställs · förväntas %@" } } }
    },
    "Starts automatically when “%@” finishes": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Startar automatiskt när ”%@” blir klar" } } }
    },
    "The conversation this was waiting for was deleted.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Konversationen som det här väntade på togs bort." } } }
    },
    "Schedule message": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Schemalägg meddelande" } } }
    },
