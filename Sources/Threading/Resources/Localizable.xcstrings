    },
    "Schedule session": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Schemalägg session" } } }
    },
    "Time zone: %@": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tidszon: %@" } } }
    },
    "Sends while Threading is running.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skickas medan Threading är igång." } } }
    },
