          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktiva ytan är inte en terminal."
          }
        }
      }
    },
    "The adopted device framebuffer: click, drag, focus, and type while the surrounding feature remains the sole owner of transport and consent." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den adopterade enhetens bildbuffert: klicka, dra, fokusera och skriv medan den omgivande funktionen ensam äger transport och samtycke."
          }
