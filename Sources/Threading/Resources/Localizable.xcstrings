    "The previous account has no fresh reading with headroom.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Det tidigare kontot saknar en färsk avläsning med utrymme kvar."}}}},
    "The previous account is no longer available.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Det tidigare kontot är inte längre tillgängligt."}}}},
