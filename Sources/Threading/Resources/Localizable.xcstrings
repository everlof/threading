      }
    },
    "Non-key command and skill suggestions that keep the composer focused while keyboard selection moves.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Kommandoförslag och färdighetsförslag som inte tar fokus från skrivfältet när tangentbordsmarkeringen flyttas." } }
