      }
    },
    "ATTACHMENTS  %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BILAGOR  %lld"
          }
        }
      }
    },
    "About %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om %@"
          }
        }
      }
    },
    "Abstract contracts are represented by a concrete live example rather than fake controls." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstrakta kontrakt representeras av ett konkret live-exempel snarare än falska kontroller."
          }
        }
      }
    },
    "Accent" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accentfärg"
          }
        }
      }
    },
    "Accept" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptera"
          }
        }
      }
    },
    "Accept Edits" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn ändringar"
          }
        }
      }
    },
    "Accept New Revision" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn ny version"
          }
        }
      }
    },
    "Accepts bounded connection evidence from a paired owner iPhone over the local network. The iPhone has its own independent switch." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar emot begränsat anslutningsunderlag från en parkopplad ägar-iPhone via det lokala nätverket. iPhone-enheten har en egen oberoende strömbrytare."
          }
        }
      }
    },
    "Access" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst"
          }
        }
      }
    },
    "Access token" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomsttoken"
          }
        }
      }
    },
    "Access token, unless anonymous" : {
      "extractionState" : "manual",
      "localizations" : {
