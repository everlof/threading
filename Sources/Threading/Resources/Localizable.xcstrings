      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Schemalagd · startar automatiskt %@" } } }
    },
    "Scheduled · starts automatically when “%@” finishes": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Schemalagd · startar automatiskt när ”%@” blir klar" } } }
    },
