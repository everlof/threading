        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BrowserFindBar begärde att stängas."
          }
        }
      }
    },
    "BrowserFindBar searched for “%@”.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BrowserFindBar sökte efter ”%@”."
          }
        }
      }
    },
    "BrowserFindBar searched back for “%@”.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BrowserFindBar sökte bakåt efter ”%@”."
          }
        }
      }
    },
    "CSS viewport presets and a custom size; no touch or device emulation.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CSS-förinställningar för visningsytan och en egen storlek; ingen pek- eller enhetsemulering."
          }
        }
      }
    },
    "Find in page, with the match count folded away when the bar is narrow.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök på sidan, med antalet träffar hopfällt när fältet är smalt."
          }
        }
      }
    },
    "The agent-visible pin layer, shown in annotation mode — click the panel to place one.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nållagret som agenten ser, visat i anteckningsläge — klicka i panelen för att placera en."
          }
        }
      }
    },
    "The bars fold their labels below their own width thresholds; drag the gallery narrower to see it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fälten fäller ihop sina etiketter under sina egna breddgränser; dra galleriet smalare för att se det."
          }
        }
      }
    }
