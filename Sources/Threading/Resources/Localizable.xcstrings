    },
    "“%@” is not a palette — it draws with whatever the app theme states. Change the app theme above to change what it gives you.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är ingen palett, utan ritar med de färger som apptemat anger. Ändra apptemat ovan för att ändra resultatet."
          }
        }
      }
    },
    "“%@” is not a usable web address.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” är inte en användbar webbadress."
          }
        }
      }
    },
    "“%@” is now version %@.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” är nu version %@."
          }
        }
      }
    },
    "“%@” is unavailable because %@ is not running or no longer registers this panel.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” är otillgänglig eftersom %@ inte körs eller inte längre registrerar detta panel."
          }
        }
      }
    },
    "“%@” was copied into Threading and is disabled until you enable it.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” har kopierats till Threading och är inaktiverad tills du aktiverar den."
          }
        }
      }
    },
    "−10%": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "−10%"
          }
        }
      }
    },
