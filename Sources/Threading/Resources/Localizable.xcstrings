        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med den här"
          }
        }
      }
    },
    "ThemedCheckbox is now %@.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ThemedCheckbox är nu %@."
          }
