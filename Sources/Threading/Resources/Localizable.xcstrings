    },
    "This chat keeps the permission mode it is running with. The agent's own setting applies the next time it starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här konversationen behåller behörighetsläget den kör med. Agentens egen inställning gäller nästa gång den startar."
          }
        }
      }
    },
    "This chat keeps the speed it is running with. The agent's own setting applies the next time it starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här chatten behåller hastigheten den körs med. Agentens egen inställning gäller nästa gång den startas."
          }
        }
      }
    },
    "This chat may archive, rename, start, resume and move chats in %@, and read account usage. It cannot widen this itself. You can revoke it any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här chatten får arkivera, byta namn på, starta, återuppta och flytta chattar i %@ samt läsa kontoanvändning. Den kan inte själv utöka behörigheten. Du kan återkalla den när som helst."
          }
        }
      }
    },
    "This chat was not opened to repair a conversation, so there is nothing to propose." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
