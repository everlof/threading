      }
    },
    "Some of these": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några av dessa"
          }
        }
      }
    },
    "What are we building today?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad bygger vi idag?"
          }
        }
      }
    },
    "Ready when you are.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo när du är."
          }
        }
      }
    },
    "Pick up where you left off, or start something new.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt där du slutade, eller börja något nytt."
          }
        }
      }
    },
    "A blank line is a good place to begin.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tom rad är en bra plats att börja på."
          }
        }
      }
    },
    "What's on your mind?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad har du i tankarna?"
          }
        }
      }
    },
    "Let's make something.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu skapar vi något."
          }
        }
      }
    },
    "Where to next?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vart härnäst?"
          }
        }
      }
    },
    "Type a brief, start a thread.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en brief, starta en tråd."
          }
        }
      }
    },
    "Good morning. Coffee, then code?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "God morgon. Kaffe, sedan kod?"
          }
        }
      }
    },
    "Morning — the day is still unwritten.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgon — dagen är ännu oskriven."
          }
        }
      }
    },
    "An early start. Let's use it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tidig start. Låt oss använda den."
          }
        }
      }
    },
    "Good afternoon. Where were we?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "God eftermiddag. Var var vi?"
          }
        }
      }
    },
    "The afternoon is young.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftermiddagen är ung."
          }
        }
      }
    },
    "A fine hour to ship something.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En utmärkt timme att leverera något."
          }
        }
      }
    },
    "Good evening. One more thing before the day ends?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "God kväll. En sak till innan dagen är slut?"
          }
        }
      }
    },
    "The evening session — the quiet hours.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvällspasset — de lugna timmarna."
          }
        }
      }
    },
    "Winding down, or winding up?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varvar du ner, eller varvar du upp?"
          }
        }
      }
    },
    "Late night. The best ideas keep odd hours.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kväll. De bästa idéerna håller udda tider."
          }
        }
      }
    },
    "Burning the midnight oil?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobbar du över midnatt?"
          }
        }
      }
    },
    "Quiet out there. Perfect.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyst där ute. Perfekt."
          }
        }
      }
    },
    "New year, new threads.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nytt år, nya trådar."
          }
        }
      }
    },
    "Midsummer light — long days, long sessions.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Midsommarljus — långa dagar, långa sessioner."
          }
        }
      }
    },
    "Spooky season. Fear no merge conflict.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusliga tider. Frukta ingen merge-konflikt."
          }
        }
      }
    },
    "Merry Christmas — threads under the tree.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "God jul — trådar under granen."
          }
        }
      }
    },
    "The quiet week between the years.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den stilla veckan mellan åren."
          }
        }
      }
    },
    "The last hours of the year. Make them count.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Årets sista timmar. Gör dem värda något."
          }
        }
      }
    },
    "Seeing the year out in good company.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser året ut i gott sällskap."
          }
        }
      }
    },
    "It's Friday — ship it or shelve it?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är fredag — leverera eller lägg på hyllan?"
          }
        }
      }
    },
    "Friday evening — one last push, or a fresh start?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fredagskväll — en sista spurt, eller en nystart?"
          }
        }
      }
    },
    "Weekend project time.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dags för helgprojekt."
          }
        }
      }
    },
    "A weekend morning — unhurried, and all yours.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En helgmorgon — utan brådska, och helt din."
          }
        }
      }
    },
    "ThemedCheckbox": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ThemedCheckbox"
          }
        }
      }
    },
    "ThemedRadioButton": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ThemedRadioButton"
          }
        }
      }
    },
    "Selected, empty, disabled, and radio-group accessibility.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vald, tom, inaktiverad och radiogruppens hjälpmedelsstöd."
          }
        }
      }
    },
    "Off, on, mixed for a group that disagrees, and disabled.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av, på, blandat för en grupp som är oense, och inaktiverad."
          }
        }
      }
    },
    "GlyphView": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GlyphView"
          }
        }
      }
    },
    "Tinted template glyphs drawn on the device pixel grid; a slot caps foreign artwork.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonade mallglyfer ritade på enhetens pixelrutnät; en lucka begränsar främmande bildmaterial."
          }
        }
      }
    },
    "Choose a project…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett projekt…"
          }
        }
      }
    },
    "Choose a project first": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett projekt först"
          }
        }
      }
    },
    "Send · ⌘Return": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka · ⌘Return"
          }
        }
      }
    },
    "Add Existing Folder…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till befintlig mapp…"
          }
        }
      }
    },
    "Create New Folder…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa ny mapp…"
          }
        }
      }
    },
    "Welcome to Threading": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen till Threading"
          }
        }
      }
    },
    "Make it yours": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör den till din"
          }
        }
      }
    },
    "Threading dresses itself. Pick a look and everything follows it, including the rest of this setup. Change it anytime in Settings ▸ Themes.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threading klär sig självt. Välj ett utseende så följer allt annat med, även resten av den här installationen. Ändra när som helst i Inställningar ▸ Teman."
          }
        }
      }
    },
    "Welcome Tour": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkomstrundtur"
          }
        }
      }
    },
    "First-launch walkthrough": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genomgången vid första start"
          }
        }
      }
    },
    "Theme, discovered accounts, conversations to import, and notifications — the same walkthrough a fresh install opens with.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, upptäckta konton, konversationer att importera och notiser — samma genomgång som en nyinstallation öppnar med."
          }
        }
      }
    },
    "Show Again…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa igen…"
          }
        }
      }
    },
    "Already signed in": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan inloggad"
          }
        }
      }
    },
    "Threading found these agent logins on this Mac. Sessions can start on any switched-on login. Name them later in Settings ▸ Accounts.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threading hittade de här agentinloggningarna på den här datorn. Sessioner kan starta på vilken påslagen inloggning som helst. Namnge dem senare i Inställningar ▸ Konton."
          }
        }
      }
    },
    "Command-line tools": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoradsverktyg"
          }
        }
      }
    },
    "No agent logins found. Sign in to Claude Code or Codex from a terminal first. Threading picks logins up from their config folders.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga agentinloggningar hittades. Logga in i Claude Code eller Codex från en terminal först. Threading plockar upp inloggningar från deras konfigurationsmappar."
          }
        }
      }
    },
    "Checking your shell's PATH…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar ditt skals PATH…"
          }
        }
      }
    },
    "Not on your shell's PATH, so sessions cannot launch. Install: %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finns inte på ditt skals PATH, så sessioner kan inte starta. Installera: %@"
          }
        }
      }
    },
    "Found": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittad"
          }
        }
      }
    },
    "Not found": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittas inte"
          }
        }
      }
    },
    "Conversations": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversationer"
          }
        }
      }
    },
    "Skip for now": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoppa över tills vidare"
          }
        }
      }
    },
    "Bring your conversations along": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med dina konversationer"
          }
        }
      }
    },
    "Looking through your past conversations…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tittar igenom dina tidigare konversationer…"
          }
        }
      }
    },
    "No conversations to import. Everything starts fresh.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga konversationer att importera. Allt börjar från noll."
          }
        }
      }
    },
    "%lld conversations found. %lld selected to import.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld konversationer hittades. %lld valda att importera."
          }
        }
      }
    },
    "%lld more ran in folders that no longer exist and were left out.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld till kördes i mappar som inte längre finns och lämnades utanför."
          }
        }
      }
    },
    "%lld conversation folders could not be read; these results are incomplete.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld konversationsmappar kunde inte läsas; resultaten är ofullständiga."
          }
        }
      }
    },
    "1 conversation folder could not be read; these results are incomplete.": {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 konversationsmapp kunde inte läsas; resultatet är ofullständigt."
          }
        }
      }
    },
    "%lld more unreadable folders were omitted.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ytterligare oläsbara mappar utelämnades."
          }
        }
      }
    },
    "Some conversation folders could not be read. The results are incomplete.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa konversationsmappar kunde inte läsas. Resultaten är ofullständiga."
          }
        }
      }
    },
    "Start using Threading": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja använda Threading"
          }
        }
      }
    },
    "Know when a session needs you": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet när en session behöver dig"
          }
        }
      }
    },
    "Agents work for minutes at a time. A notification says when one is blocked on an approval, or finished while you were elsewhere. Only then, and only while Threading is in the background.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter arbetar flera minuter i taget. En notis berättar när en väntar på ett godkännande, eller blev klar medan du var någon annanstans. Bara då, och bara medan Threading är i bakgrunden."
          }
        }
      }
    },
    "Enable notifications": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera notiser"
          }
        }
      }
    },
    "Only for the approval alert, which is the one that waits.": {
      "localizations": {
        "sv": {
