    "The project data could not be saved. Its running agent was left alone.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Projektdata kunde inte sparas. Dess körande agent lämnades orörd." } } } },
    "The project data could not be saved. Its running processes were left alone.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Projektdata kunde inte sparas. Dess körande processer lämnades orörda." } } } },
