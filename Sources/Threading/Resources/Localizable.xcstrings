    "That login could not be found.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den inloggningen kunde inte hittas." } } } },
    "%@ is close to its own limit now.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ är nära sin egen gräns nu." } } } },
