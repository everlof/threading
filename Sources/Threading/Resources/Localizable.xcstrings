      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observerade återställningsgränser"
          }
        }
      }
    },
    "Observed work" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observerat arbete"
          }
        }
      }
    },
    "Off" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av"
          }
        }
      }
    },
    "Off, on, disabled, target/action, and accessibility." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av, på, inaktiverat, mål/åtgärd och tillgänglighet."
          }
        }
      }
    },
    "Off, on, mixed for a group that disagrees, and disabled." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av, på, blandat för en grupp som är oense, och inaktiverad."
          }
        }
      }
    },
    "Off." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av."
          }
        }
      }
    },
    "Off. A browser on your tailnet gets a certificate warning." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av. En webbläsare i ditt tailnet får en certifikatvarning."
          }
        }
      }
    },
    "Off. Nothing on this network can reach this Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av. Inget i det här nätverket kan nå den här Mac-datorn."
          }
        }
      }
    },
    "Off. Threading is not published on your tailnet." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av. Threading publiceras inte i ditt tailnet."
          }
        }
      }
    },
    "Offer this account for new sessions" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erbjuda detta konto för nya konversationer"
          }
        }
      }
    },
    "Old version" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidigare version"
          }
        }
      }
    },
    "Older events dropped" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äldre händelser har släppts"
          }
        }
      }
    },
    "Oldest First" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äldsta först"
          }
        }
      }
    },
    "On" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På"
          }
        }
      }
    },
    "On toggle" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På växling"
          }
        }
      }
    },
    "On — no Claude sign-in found in the keychain." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På — ingen Claude-inloggning hittades i nyckelringen."
          }
        }
      }
    },
    "On — reading %lld of %lld logins." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På — läser %lld av %lld inloggningar."
          }
        }
      }
    },
    "On — reading %lld of %lld logins. Toggle off and on to be asked again for the rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På — läser %lld av %lld inloggningar. Stäng av och slå på igen för att bli tillfrågad om resten."
          }
        }
      }
    },
    "Once a day, Threading asks GitHub about the app, npm about installed Claude, Codex, Grok and OpenCode tools, and cursor.com about installed Cursor. The app request carries the version you are on and your macOS version, the way any download does. The agent requests include no account, project, session or installed version. Neither carries an identifier or anything about your projects. Turn the check off in General and nothing is asked." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gång om dagen frågar Threading GitHub om appen, npm om installerade verktyg för Claude, Codex, Grok och OpenCode samt cursor.com om installerade Cursor. Appförfrågan innehåller versionen du kör och din macOS-version, precis som vilken nedladdning som helst. Förfrågningarna för agenter innehåller inget konto, projekt, ingen session och ingen installerad version. Ingen av dem bär en identifierare eller något om dina projekt. Stäng av kontrollen under Allmänt så skickas inga förfrågningar."
          }
        }
      }
    },
    "Once a day, Threading asks its release feed on GitHub whether a newer version exists. Updates are installed by Sparkle, and only after you agree to each one. Off, nothing is asked — Help ▸ Check for Updates… still works." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gång om dagen frågar Threading sitt utgivningsflöde på GitHub om det finns en nyare version. Uppdateringar installeras av Sparkle, och bara efter att du godkänt varje enskild. Avstängt frågas ingenting – Hjälp ▸ Sök efter uppdateringar… fungerar ändå."
          }
        }
      }
    },
    "Once a day, Threading checks GitHub for the app and each installed agent's official release source. App updates use Sparkle after you agree; agent updates run in a visible terminal only when you choose Update. Off stops both background checks — Help ▸ Check for Updates… still checks the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gång om dagen kontrollerar Threading GitHub för appen och den officiella utgivningskällan för varje installerad agent. Appuppdateringar använder Sparkle efter att du har godkänt; agentuppdateringar körs i en synlig terminal först när du väljer Uppdatera. Av stoppar båda bakgrundskontrollerna — Hjälp ▸ Sök efter uppdateringar… kontrollerar fortfarande appen."
          }
        }
      }
    },
    "One agent working" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En agent arbetar"
          }
        }
      }
    },
    "One audit row per source, resting and selected: the ledger's fixed grid of category, phase, operation and fidelity." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En granskningsrad per källa, vilande och markerad: liggarens fasta rutnät av kategori, fas, operation och trohet."
          }
        }
      }
    },
    "One continuous themed card whose repeating rows are recycled at the viewport boundary. Scroll it to exercise real cell reuse rather than a retained stack disguised as a list." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett sammanhängande temakort vars upprepade rader återanvänds vid visningsområdets gräns. Rulla för att prova faktisk cellåteranvändning i stället för en bevarad stapel förklädd till lista."
          }
        }
      }
    },
    "One destination a search turned up: the matched words marked on the title, the path underneath. These rows follow the query field above; hover, press, Space and the focus ring are live." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En destination en sökning hittade: de matchade orden markerade i titeln, sökvägen under. Raderna följer sökfältet ovanför; hovring, tryck, mellanslag och fokusringen är levande."
          }
        }
      }
    },
    "One extension generation publishes scoped CI state to both real row shells; project count and both rows' actions remain host-owned." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tilläggsgeneration publicerar avgränsad CI-status till båda de verkliga raderna. Projektantalet och åtgärderna på båda raderna ägs fortfarande av värdappen."
          }
        }
      }
    },
    "One footer key names the user-authored marker shared by a group of provider gauges. Toggle it to verify that the line and its legend appear and leave as one semantic state." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enda sidfotsförklaring namnger den användarskapade markören som delas av en grupp leverantörsmätare. Växla den för att verifiera att linjen och dess förklaring visas och försvinner som ett semantiskt tillstånd."
          }
        }
      }
    },
    "One height across every control in the row, the two runs held at opposite edges, and the outer two aligned by ink. The height is the theme's: switch the style above and every member follows the chooser." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En och samma höjd för varje kontroll i raden, de två grupperna hållna mot var sin kant, och de två yttersta linjerade efter bläcket. Höjden är temats: byt stil ovanför så följer varje medlem väljaren."
          }
        }
      }
    },
    "One line naming it" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad som namnger det"
          }
        }
      }
    },
    "One notice when a sibling settles, exits, or hits its limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avisering när en syskonsession blir klar, avslutas eller når sin gräns."
          }
        }
      }
    },
    "One of these was written in the last few minutes, so something is probably building in it right now. Removing it will interrupt that build." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En av dem skrevs till under de senaste minuterna, så något byggs antagligen i den just nu. Om du tar bort den avbryts bygget."
          }
        }
      }
    },
    "One of your own paired devices" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En av dina egna parkopplade enheter"
          }
        }
      }
    },
    "One of your own paired devices. Manage paired devices in Remote Access settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En av dina egna parkopplade enheter. Hantera parkopplade enheter i inställningarna för Fjärråtkomst."
          }
        }
      }
    },
    "One or more OpenCode exports could not be read." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eller flera OpenCode-exporter kunde inte läsas."
          }
        }
      }
    },
    "One or more manager roles could not be revoked. Roles already revoked remain revoked." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eller flera managerroller kunde inte återkallas. Roller som redan har återkallats förblir återkallade."
          }
        }
      }
    },
    "One other session closes; its conversation is kept and can be resumed." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan session stängs; dess konversation sparas och kan återupptas."
          }
        }
      }
    },
    "One person · This chat only · Accept within 24 hours\nAccess lasts until you choose Stop Sharing Chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En person · Bara den här chatten · Acceptera inom 24 timmar\nÅtkomsten gäller tills du väljer Sluta dela chatt."
          }
        }
      }
    },
    "One plate, two halves: hover each in turn — the raise stays inside the shared silhouette." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En platta, två halvor: håll pekaren över dem i tur och ordning — upphöjningen stannar inom den gemensamma silhuetten."
          }
        }
      }
    },
    "One ribbon for every standing reason a conversation has stopped. Four provider states first: the offer, the offer with no login to move to, the same offer being carried out, and one that could not be taken. Then three curfews — the user's own line, which wears the conduct mark rather than the triangle, ends with Lift rather than a ✕, and states plainly where Threading cannot tell whether the session is working. The button names the whole action, which is why pressing it asks nothing further." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett band för varje stående skäl till att ett samtal har stannat. Först fyra leverantörslägen: erbjudandet, erbjudandet utan inloggning att flytta till, samma erbjudande medan det utförs, och ett som inte gick att ta. Sedan tre spärrtider — användarens egen gräns, som bär uppförandemärket i stället för triangeln, avslutas med Häv i stället för ett ✕, och säger rakt ut när Threading inte kan avgöra om sessionen arbetar. Knappen namnger hela sin åtgärd, vilket är varför ett tryck inte frågar något mer."
          }
        }
      }
    },
    "One rooted branch of the same marks: click a circle to zoom it, the breadcrumb or Escape to come back out." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rotad gren av samma markeringar: klicka på en cirkel för att zooma in, sökvägen eller Esc för att ta dig ut igen."
          }
        }
      }
    },
    "One session could not be taken back." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session kunde inte tas tillbaka."
          }
        }
      }
    },
    "One session keeps working in the background and is taken back on the next launch." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session fortsätter arbeta i bakgrunden och tas tillbaka vid nästa start."
          }
        }
      }
    },
    "One session kept running while Threading was closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session fortsatte köra medan Threading var stängt."
          }
        }
      }
    },
    "One session was lost when the background session host restarted. Its conversation can be resumed." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session gick förlorad när värdprocessen för bakgrundssessioner startade om. Dess konversation kan återupptas."
          }
        }
      }
    },
    "One side is an image and the other is text — there is no comparison to draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ena sidan är en bild och den andra är text – det finns ingen jämförelse att dra."
          }
        }
      }
    },
    "One side is larger than the %@ the comparison reads." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ena sidan är större än den %@ jämförelsen visar."
          }
        }
      }
    },
    "One-time grants end with the running app and are not listed here." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gångs tillstånd upphör när programmet körs och listas inte här."
          }
        }
      }
    },
    "Online" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online"
          }
        }
      }
    },
    "Only directories git ignores and a known tool can rebuild are offered. Anything tracked in a repository is left alone, whatever it is called — and ignored files that are not build output, such as .env files, are never touched. In a temporary location a build cache is offered only when Xcode's own manifest identifies it, never an agent's working copy of a repository. Removal is immediate rather than moved to the Trash, since space in the Trash has not been reclaimed." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast kataloger som git ignorerar och som ett känt verktyg kan återskapa visas. Allt som spåras i ett kodförråd lämnas orört, oavsett namn. Ignorerade filer som inte är byggutdata, till exempel .env-filer, rörs aldrig. På en tillfällig plats erbjuds en byggcache bara när Xcodes eget manifest identifierar den, aldrig en agents arbetskopia av ett kodförråd. Borttagning sker direkt i stället för via Papperskorgen, eftersom utrymmet annars inte frigörs."
          }
        }
      }
    },
    "Only directories git ignores and a known tool can rebuild are offered. Anything tracked in a repository is left alone, whatever it is called — and ignored files that are not build output, such as .env files, are never touched. Removal is immediate rather than moved to the Trash, since space in the Trash has not been reclaimed." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast kataloger som git ignorerar och som ett känt verktyg kan återskapa visas. Allt som spåras i ett kodförråd lämnas orört, oavsett namn. Ignorerade filer som inte är byggutdata, till exempel .env-filer, rörs aldrig. Borttagning sker direkt i stället för via Papperskorgen, eftersom utrymmet annars inte frigörs."
          }
        }
      }
    },
    "Only for an extension companion that captures the screen. The built-in interface inspector draws from Threading's own view tree and needs nothing." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast för en tilläggsföljeslagare som spelar in skärmen. Den inbyggda gränssnittsinspektören ritar från Threadings eget vyträd och behöver ingenting."
          }
        }
      }
    },
    "Only for an extension companion that controls the pointer or keyboard. Threading itself never asks for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast för en tilläggsföljeslagare som styr pekaren eller tangentbordet. Threading själv ber aldrig om den."
          }
        }
      }
    },
    "Only for the approval alert, which is the one that waits." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara för godkännandenotisen, som är den som väntar."
          }
        }
      }
    },
    "Only interruptions you can safely stop are listed. Anything that deletes something for good, or grants access to a website, a tool, an extension or another person, always asks." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast avbrott du tryggt kan stänga av listas här. Allt som raderar något för gott, eller ger åtkomst till en webbplats, ett verktyg, ett tillägg eller en annan person, frågar alltid."
          }
        }
      }
    },
    "Only scan this owner code on a device you control. It can access every chat on this Mac. The beta relay and pairing are renewed when Threading restarts." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna bara den här ägarkoden med en enhet du kontrollerar. Den ger åtkomst till alla konversationer på datorn. Betareläet och parkopplingen förnyas när Threading startas om."
          }
        }
      }
    },
    "Only scan this owner code on a device you control. It can access every chat on this Mac. The code expires after one successful pairing; that device stays paired until you revoke it here." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna bara den här ägarkoden på en enhet du kontrollerar. Den kan komma åt alla chattar på den här Mac-datorn. Koden upphör efter en lyckad parkoppling; enheten förblir parkopplad tills du återkallar den här."
          }
        }
      }
    },
    "Only the blocked alert ever sounds — the other two are silent either way. Off shows it without the ping." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara notisen om ett väntande godkännande låter — de andra två är tysta oavsett. Av visar den utan ljudet."
          }
        }
      }
    },
    "Open" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna"
          }
        }
      }
    },
    "Open %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna %@"
          }
        }
