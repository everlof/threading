        }
      }
    },
    "The scratchpad could not be saved.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Kladdblocket kunde inte sparas."}}}},
    "The scratchpad folder could not be created: %@": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Kladdblocksmappen kunde inte skapas: %@"}}}},
    "The scratchpad folder could not be moved: %@": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Kladdblocksmappen kunde inte flyttas: %@"}}}},
    "Threading created this folder to hold chats that are not about any project. It is an ordinary git repository, so nothing you write here is lost — and nothing outside it belongs to Threading. You can move it, or point Threading somewhere else, in Settings.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Threading skapade den här mappen för chattar som inte handlar om något projekt. Det är ett vanligt git-arkiv, så inget du skriver här går förlorat — och inget utanför den hör till Threading. Du kan flytta den, eller ange en annan plats för Threading, i Inställningar."}}}},
    "Changed files": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Ändrade filer"}}}},
    "Disable rich preview": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Inaktivera utökad förhandsvisning"}}}},
    "Disable word diffs": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Inaktivera ordskillnader"}}}},
