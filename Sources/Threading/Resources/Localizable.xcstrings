    "The thread only. The terminal keeps its own font in Profile.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast tråden. Terminalen behåller sin egen typsnitt i Profil."
          }
