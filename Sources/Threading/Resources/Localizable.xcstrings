    "Scratchpad": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Kladdblock"}}}},
    "Something is already at %@.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Det finns redan något på %@."}}}},
    "Something that is not a folder is already at %@.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Det finns redan något som inte är en mapp på %@."}}}},
    "Start New Project…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Starta nytt projekt…"}}}},
    "The scratchpad could not be moved": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladdblocket kunde inte flyttas"
