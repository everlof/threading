    "%@. %@": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@. %@" } } } },
    "LimitEscapeStripView": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "LimitEscapeStripView" } } } },
    "The way past a spent usage limit. Three states: the offer, the same offer being carried out, and one that could not be taken. The button names the whole action, which is why pressing it asks nothing further.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Vägen förbi en förbrukad användningsgräns. Tre lägen: erbjudandet, samma erbjudande medan det utförs, och ett som inte gick att ta. Knappen namnger hela sin åtgärd, vilket är varför ett tryck inte frågar något mer." } } } },
    "Escape suggestion dismissed.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Förslaget avfärdades." } } } },
    "Continuing on the other login.": { "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Fortsätter på den andra inloggningen." } } } },
