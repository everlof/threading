    },
    "Detection of files named in %@'s output is turned off in Settings › General. Images you attach, and ones the agent shows in the panel, still appear here.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiering av filer som nämns i %@:s utdata är avstängd i Inställningar › Allmänt. Bilder du bifogar, och de som agenten visar i panelen, visas fortfarande här."
          }
        }
      }
    },
