      }
    },
    "There is no next location." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen nästa plats."
          }
        }
      }
    },
    "There is no other login to move this conversation to." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen annan inloggning att flytta konversationen till."
          }
        }
      }
    },
    "There is no other tab to select." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen annan flik att välja."
          }
        }
      }
    },
    "There is no previous location." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen föregående plats."
          }
        }
      }
    },
    "There is no tab to close." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen flik att stänga."
          }
        }
      }
    },
    "There is no usage reading yet to schedule against." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ännu ingen användningsavläsning att schemalägga mot."
          }
        }
      }
    },
    "There is nothing here to schedule." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inget här att schemalägga."
          }
        }
      }
    },
    "There is nothing running to stop." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget körs som går att stoppa."
          }
        }
      }
    },
    "There was no turn to stop." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fanns ingen tur att stoppa."
          }
        }
      }
    },
    "These colours come from the app theme above. Duplicate them to edit a copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa färger kommer från appens tema ovanför. Dubblikera dem för att redigera en kopia."
          }
        }
      }
    },
    "These files are binary, and not images Threading can compare." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa filer är binära och inte bilder som Threading kan jämföra."
          }
        }
      }
    },
    "They lose this chat immediately and anything they have open closes. Their invitation was single-use, so letting them back in means sharing the chat again." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De förlorar chatten omedelbart och allt de har öppet stängs. Deras inbjudan var för engångsbruk, så att släppa in dem igen innebär att dela chatten på nytt."
          }
        }
      }
    },
    "They resume in the background, one at a time, and are already running when you open them." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De återupptas i bakgrunden, en i taget, och är redan igång när du öppnar dem."
          }
        }
      }
    },
    "They will be deleted immediately, not moved to the Trash. Each one is rebuilt by the command shown beside it, which takes time but no decisions." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De raderas omedelbart och flyttas inte till Papperskorgen. Var och en återskapas av kommandot som visas bredvid. Det tar tid men kräver inga beslut."
          }
        }
      }
    },
    "Thin marks are reads; solid marks are edits." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunna markeringar är läsningar; fyllda markeringar är redigeringar."
          }
        }
      }
    },
    "Thin marks are reads; solid marks are edits; a cap means agents overlap." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunna markeringar är läsningar; fyllda är redigeringar; en toppmarkering betyder att agenter överlappar."
          }
        }
      }
    },
    "Third choice" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tredje valet"
          }
        }
      }
    },
    "This %@ login needs signing in again." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här %@-inloggningen behöver loggas in igen."
          }
        }
      }
    },
    "This Chat Has No Project" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatten hör inte till något projekt"
          }
        }
      }
    },
    "This Mac has no certificate yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Mac-datorn har inget certifikat än."
          }
        }
      }
    },
    "This Mac is connected to your tailnet." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna Mac är ansluten till ditt tailnet."
          }
        }
      }
    },
    "This Mac is not reachable from another device." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här datorn kan inte nås från någon annan enhet."
          }
        }
      }
    },
    "This Mac is not signed in to Tailscale." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna Mac är inte inloggad på Tailscale."
          }
        }
      }
    },
    "This Mac mints its certificate the first time a way in needs one." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Mac-datorn skapar sitt certifikat första gången en väg in behöver ett."
          }
        }
      }
    },
    "This Mac’s certificate file is not a certificate. Resetting the identity mints a new one, and every paired device has to scan again." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Mac-datorns certifikatfil är inte ett certifikat. Att återställa identiteten skapar ett nytt, och varje parkopplad enhet måste skanna igen."
          }
        }
      }
    },
    "This Mac’s certificate was written by a newer version of Threading. Update Threading rather than resetting the identity, which would unpair every device." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Mac-datorns certifikat skrevs av en nyare version av Threading. Uppdatera Threading i stället för att återställa identiteten, vilket skulle koppla bort varje enhet."
          }
        }
      }
    },
    "This Mac’s tailnet address" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här Mac-datorns tailnet-adress"
          }
        }
      }
    },
    "This Turn" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här turen"
          }
        }
      }
    },
    "This account never reaches its short limit, so moving it would gain nothing." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta konto når aldrig sin korta gräns, så att flytta den skulle inte ge något."
          }
        }
      }
    },
    "This account runs on the provider's own limits." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här kontot går på leverantörens egna gränser."
          }
        }
      }
    },
    "This agent cannot stop a turn in progress." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna agent kan inte stoppa en pågående tur."
          }
        }
      }
    },
    "This alert follows the app theme and always gives Escape back to its source." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dialogen följer appens tema och låter alltid Escape återgå till källan."
          }
        }
      }
    },
    "This anchored surface flips at screen edges and follows live theme changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den förankrade ytan byter sida vid skärmkanter och följer temabyten direkt."
          }
        }
      }
    },
    "This baseline was captured by the user, so only the user can replace or remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baslinjen togs av användaren, så bara användaren kan ersätta eller ta bort den."
          }
        }
      }
    },
    "This branch has no commit to describe." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här grenen har ingen incheckning att beskriva."
          }
        }
      }
    },
    "This build does not include the tool yet, so there is nothing to install." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen innehåller inte verktyget ännu, så det finns inget att installera."
          }
        }
      }
    },
    "This can change data outside Threading using the browser's signed-in session.%@\n\nApprove only if this is part of the task you gave the agent." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kan ändra data utanför Threading genom att använda webbläsarens inloggade session.%@\n\nGodkänn endast om detta är en del av uppgiften du gav agenten."
          }
        }
      }
    },
    "This chat cannot be shared yet" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här konversationen kan inte delas än"
