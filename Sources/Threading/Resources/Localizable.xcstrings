    "UsageDashboardView": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "UsageDashboardView" } } } },
    "UsageLimitLegendView": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "UsageLimitLegendView" } } } },
    "One footer key names the user-authored marker shared by a group of provider gauges. Toggle it to verify that the line and its legend appear and leave as one semantic state.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En enda sidfotsförklaring namnger den användarskapade markören som delas av en grupp leverantörsmätare. Växla den för att verifiera att linjen och dess förklaring visas och försvinner som ett semantiskt tillstånd." } } } },
    "UsageReadingLabel": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "UsageReadingLabel" } } } },
    "Narrow the row and the reading gives up whole windows rather than characters: everything, then one complete window, then nothing.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Smalna av raden så ger avläsningen upp hela fönster i stället för tecken: allt, sedan ett helt fönster, sedan ingenting." } } } },
    "Uncached input": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Icke-cachelagrad indata" } } } },
    "Use Left and Right Arrow to inspect points.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Använd vänster- och högerpil för att granska punkter." } } } },
    "Weekly": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Veckovis" } } } },
    "What Threading could measure, including unsupported and partial sources.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Vad Threading kunde mäta, inklusive källor som saknas eller bara stöds delvis." } } } },
    "A bounded diff-shaped slice for a code comment: target rows keep their marker, additions and removals keep theirs, and a large source never turns into a large sheet.": {
      "extractionState": "manual",
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ett begränsat, diff-format utdrag för en kodkommentar: målrader behåller sin markör, tillägg och borttagningar sina, och en stor källfil blir aldrig ett stort blad." } } }
    },
    "Activity beam is idle.": {
      "extractionState": "manual",
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivitetsringen är inaktiv." } } }
    },
    "Activity beam shows one working agent.": {
      "extractionState": "manual",
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivitetsringen visar en arbetande agent." } } }
    },
    "Activity beam shows three agents, including top effort.": {
      "extractionState": "manual",
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivitetsringen visar tre agenter, inklusive högsta arbetsinsats." } } }
    },
