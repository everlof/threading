    },
    "Dwell (sidebar cards)": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dröjning (sidofältets kort)" } } }
    },
    "A fixed semantic grid for transcript content. Narrow the gallery to make cells wrap; the horizontal scroller appears only after the columns reach their readable floor, and every value remains selectable.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ett fast semantiskt rutnät för transkriptinnehåll. Gör galleriet smalare för att radbryta cellerna; den vågräta rullisten visas först när kolumnerna når sin läsbara minimibredd, och alla värden förblir markerbara." } } }
    },
    "Extensions are copied into Threading before they can run. Import a .threadingextension package or an unpacked development directory; importing leaves one disabled, and enabling it starts a supervised process with the capabilities declared in its manifest.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tillägg kopieras till Threading innan de kan köras. Importera ett .threadingextension-paket eller en uppackad utvecklingsmapp; ett importerat tillägg lämnas inaktiverat, och när det aktiveras startas en övervakad process med funktionerna som anges i manifestet." } } }
    },
    "Invalid": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ogiltig" } } }
    },
    "ThemedDisclosureRow": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "ThemedDisclosureRow" } } }
    },
    "ThemedDocumentTableView": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "ThemedDocumentTableView" } } }
    },
    "Updating": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Uppdaterar" } } }
    },
    "origin": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "ursprung" } } }
    },
    "revoke": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "återkalla" } } }
    },
    "website access": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "webbplatsåtkomst" } } }
    },
    "%@ is controlling this chat": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ styr den här chatten" } } }
    },
    "Away — control returns to the owner shortly": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inte här — kontrollen återgår snart till ägaren" } } }
    },
    "HTTPS port 8443 already has a Tailscale Serve handler. Remove it, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "HTTPS-port 8443 har redan en Tailscale Serve-hanterare. Ta bort den och försök igen." } } }
    },
    "Reclaim": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ta tillbaka" } } }
    },
    "Tailscale HTTPS port 8443 is already configured. Remove that Serve handler, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscales HTTPS-port 8443 är redan konfigurerad. Ta bort Serve-hanteraren och försök igen." } } }
    },
    "Your input was not sent.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Din inmatning skickades inte." } } }
    },
    "Would like input control": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Vill ha inmatningskontroll" } } }
    },
    "%@ controlling": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ styr" } } }
    },
    "%@ is controlling this chat. Your draft stays here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ styr den här chatten. Ditt utkast finns kvar." } } }
    },
    "%@ is controlling · everyone else can watch and keep a draft.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ styr · alla andra kan titta och behålla ett utkast." } } }
    },
    "Another participant": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En annan deltagare" } } }
    },
    "Away — can take control when they return": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inte här — kan ta kontroll när personen återvänder" } } }
    },
    "Collaborative": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Samarbete" } } }
    },
    "Controller": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Styrning" } } }
    },
    "Everyone with reply access can send. Terminal lines are still submitted atomically.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Alla med svarsåtkomst kan skicka. Terminalrader skickas fortfarande atomärt." } } }
    },
    "Everyone with reply access can send.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Alla med svarsåtkomst kan skicka." } } }
    },
    "Focused": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Fokuserat" } } }
    },
    "Focused on owner": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Fokuserat på ägaren" } } }
    },
    "Input control": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inmatningskontroll" } } }
    },
    "New shared chats": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Nya delade chattar" } } }
    },
    "Reports from your phone": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Rapporter från din telefon" } } }
    },
    "The project’s own checkout": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Projektets egen utcheckning" } } }
    },
    "Their own workspace, merged when finished": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En egen arbetsyta, sammanfogad när den är klar" } } }
    },
    "Their own workspace, kept for review": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En egen arbetsyta, sparad för granskning" } } }
    },
    "Online": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Online" } } }
    },
    "One of your own paired devices. Manage paired devices in Remote Access settings.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En av dina egna parkopplade enheter. Hantera parkopplade enheter i inställningarna för Fjärråtkomst." } } }
    },
    "Others can watch and keep drafts.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Andra kan titta och behålla utkast." } } }
    },
    "Owner": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ägare" } } }
    },
    "Allow Threading to publish this private service, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tillåt Threading att publicera den här privata tjänsten och försök sedan igen." } } }
    },
    "Checked when Remote Access turns on.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrolleras när Fjärråtkomst slås på." } } }
    },
    "Checking your tailnet status…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrollerar status för ditt tailnet…" } } }
    },
    "Enable Tailscale HTTPS for this tailnet, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivera Tailscale HTTPS för detta tailnet och försök sedan igen." } } }
    },
    "Enable HTTPS…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivera HTTPS…" } } }
    },
    "Enable Tailscale Serve for this tailnet, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivera Tailscale Serve för detta tailnet och försök sedan igen." } } }
    },
    "Enable Tailscale Serve…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivera Tailscale Serve…" } } }
    },
    "%1$@ The local mirror is ready on 127.0.0.1:%2$@.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%1$@ Den lokala spegeln är klar på 127.0.0.1:%2$@." } } }
    },
    "Approve this Mac in the Tailscale admin console, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Godkänn denna Mac i Tailscales adminkonsol och försök sedan igen." } } }
    },
    "Check that Tailscale is running on this Mac, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrollera att Tailscale körs på denna Mac och försök sedan igen." } } }
    },
    "Checking Tailscale": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrollerar Tailscale" } } }
    },
    "Enable HTTPS certificates in the Tailscale admin console, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Aktivera HTTPS-certifikat i Tailscales adminkonsol och försök sedan igen." } } }
    },
    "HTTPS certificates are not enabled for this tailnet.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "HTTPS-certifikat är inte aktiverade för det här tailnetet." } } }
    },
    "HTTPS port 8443 already has a Tailscale Serve handler.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "HTTPS-porten 8443 har redan en Tailscale Serve-hanterare." } } }
    },
    "Publishing on your tailnet": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Publicerar på ditt tailnet" } } }
    },
    "Reading this Mac’s Tailscale status.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Läser Tailscale-statusen på denna Mac." } } }
    },
    "Remove that handler, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ta bort den hanteraren och försök sedan igen." } } }
    },
    "Retry the connection.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Försök ansluta igen." } } }
    },
    "Tailscale Serve is not enabled for this tailnet.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale Serve är inte aktiverat för det här tailnetet." } } }
    },
    "Tailscale is not installed on this Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale är inte installerat på denna Mac." } } }
    },
    "Tailscale is not running on this Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale körs inte på denna Mac." } } }
    },
    "This Mac is not signed in to Tailscale.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Denna Mac är inte inloggad på Tailscale." } } }
    },
    "Waiting for the tailnet HTTPS endpoint to answer. The first time can take up to a minute.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Väntar på att tailnetets HTTPS-slutpunkt ska svara. Första gången kan det ta upp till en minut." } } }
    },
    "Grants a grace to cross the gap, and holds while the pointer rests here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ger en frist att korsa glappet och håller kvar medan pekaren vilar här." } } }
    },
    "Held (extension detail)": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Hålls kvar (tilläggsdetaljen)" } } }
    },
    "Hover timing as configured policy: instant, dwell, and dwell with a grace that holds.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Hovringstiming som konfigurerad policy: omedelbar, dröjning, och dröjning med frist som håller kvar." } } }
    },
    "HoverPopoverScheduler": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "HoverPopoverScheduler" } } }
    },
    "Install Tailscale on this Mac to use private access.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Installera Tailscale på denna Mac för att använda privat åtkomst." } } }
    },
    "Install Tailscale on this Mac, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Installera Tailscale på denna Mac och försök sedan igen." } } }
    },
    "Instant (usage pill)": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Omedelbar (användningspillret)" } } }
    },
    "Looking for Tailscale…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Letar efter Tailscale…" } } }
    },
    "Publishing Threading privately…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Publicerar Threading privat…" } } }
    },
    "Ready at %@.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Redo på %@." } } }
    },
    "Remote Access is not ready.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Fjärråtkomst är inte redo." } } }
    },
    "Sign in to Tailscale on this Mac, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Logga in i Tailscale på denna Mac och försök sedan igen." } } }
    },
    "Signed in and running": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inloggad och igång" } } }
    },
    "Tailscale Serve could not publish Threading on this tailnet.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale Serve kunde inte publicera Threading på detta tailnet." } } }
    },
    "Tailscale Serve could not publish Threading. Retry the connection.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale Serve kunde inte publicera Threading. Försök ansluta igen." } } }
    },
    "Tailscale did not allow Threading to publish this private service.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale tillät inte Threading att publicera denna privata tjänst." } } }
    },
    "Tailscale installed": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale installerat" } } }
    },
    "Tailscale is installed.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tailscale är installerat." } } }
    },
    "This Mac is connected to your tailnet.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Denna Mac är ansluten till ditt tailnet." } } }
    },
    "Threading could not read Tailscale’s status.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Threading kunde inte läsa Tailscales status." } } }
    },
    "Turn on Tailscale on this Mac, then retry.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Slå på Tailscale på denna Mac och försök sedan igen." } } }
    },
    "Turn on a way in first.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Slå på ett sätt in först." } } }
    },
    "This chat cannot be shared yet": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den här konversationen kan inte delas än" } } }
    },
    "Share with someone on your Wi-Fi or tailnet who has the Threading app. A single-use invitation to this one chat. It expires in 24 hours if nobody accepts it; once accepted, that person keeps access until you choose Stop Sharing Chat. No link reaches your other chats, projects, or settings.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dela med någon på ditt Wi-Fi eller tailnet som har Threading-appen. En inbjudan för engångsbruk till just den här konversationen. Den upphör efter 24 timmar om ingen tar emot den. När någon har tagit emot den behåller personen åtkomsten tills du väljer Stoppa delning av konversation. Ingen länk når dina andra konversationer, projekt eller inställningar." } } }
    },
    "Remote Access binds only the ways in you turn on": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Fjärråtkomst binder bara de sätt in du slår på" } } }
    },
    "The listener always binds 127.0.0.1, and binds a network address only for a way in you switched on. Each of those presents this Mac’s own certificate, which your paired phone pins; nothing else terminates the traffic.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Lyssnaren binder alltid 127.0.0.1 och binder en nätverksadress bara för ett sätt in som du slagit på. Var och en av dem visar denna Macs eget certifikat, som din parkopplade telefon nålar fast. Ingen annan avslutar trafiken." } } }
    },
    "Visible exactly while the pointer is on the anchor.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Synlig exakt så länge pekaren är på ankaret." } } }
    },
    "Waiting for Tailscale.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Väntar på Tailscale." } } }
    },
    "Waiting for the installation check.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Väntar på installationskontrollen." } } }
    },
    "A reset moves file state into “Threading Resets” rather than deleting it. Reset Everything also revokes paired-owner credentials; Reset Settings keeps them. Agent logins and anything the Claude or Codex CLIs keep stay where they are.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "En återställning flyttar filstatus till ”Threading Resets” i stället för att radera den. Återställ allt återkallar även autentiseringsuppgifter för parkopplade ägarenheter; Återställ inställningar behåller dem. Agentinloggningar och allt som Claude- eller Codex-CLI:erna sparar ligger kvar." } }
      }
    },
    "The above, plus every project, session, conversation, cache and paired owner device. Threading restarts as if newly installed.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Ovanstående samt alla projekt, sessioner, konversationer, cacheminnen och parkopplade ägarenheter. Threading startar om som nyinstallerat." } }
      }
    },
    "Threading will restart as if newly installed: no projects, no sessions, no conversations. Files are moved into a dated folder beside your data so they can be recovered by hand. Paired-owner credentials are revoked and cannot be recovered from that folder.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Threading startar om som nyinstallerat: inga projekt, inga sessioner, inga konversationer. Filer flyttas till en daterad mapp bredvid dina data så att de kan återställas manuellt. Autentiseringsuppgifter för parkopplade ägarenheter återkallas och kan inte återställas från den mappen." } }
      }
    },
    "Both": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Båda" } }
      }
    },
    "Last seen %@": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Senast sedd %@" } }
      }
    },
    "No durable owner devices are paired yet.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Inga varaktiga ägarenheter är parkopplade än." } }
      }
    },
    "Only scan this owner code on a device you control. It can access every chat on this Mac. The code expires after one successful pairing; that device stays paired until you revoke it here.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Skanna bara den här ägarkoden på en enhet du kontrollerar. Den kan komma åt alla chattar på den här Mac-datorn. Koden upphör efter en lyckad parkoppling; enheten förblir parkopplad tills du återkallar den här." } }
      }
    },
    "Open Threading on iPhone, choose Pair a Mac, then scan this one-time code.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Öppna Threading på iPhone, välj Parkoppla en Mac och skanna sedan den här engångskoden." } }
      }
    },
    "Paired %@": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Parkopplad %@" } }
      }
    },
    "Paired devices unavailable": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Parkopplade enheter är inte tillgängliga" } }
      }
    },
    "Paired devices": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Parkopplade enheter" } }
      }
    },
    "Pairing Unavailable": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Parkoppling inte tillgänglig" } }
      }
    },
    "Pairing unavailable": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Parkoppling inte tillgänglig" } }
      }
    },
    "Private connection unavailable": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Privat anslutning inte tillgänglig" } }
      }
    },
    "Relay supports ordinary share links. Tailscale keeps access inside your private tailnet. Both uses Tailscale for pairing and the relay for sharing.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Relä stöder vanliga delningslänkar. Tailscale håller åtkomsten inom ditt privata tailnet. Båda använder Tailscale för parkoppling och reläet för delning." } }
      }
    },
    "Retry Connection": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Försök ansluta igen" } }
      }
    },
    "Revoke %@": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Återkalla %@" } }
      }
    },
    "Revoke %@?": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Återkalla %@?" } }
      }
    },
    "Tailscale": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Tailscale" } }
      }
    },
    "The QR code appears here as soon as the selected connection is ready.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "QR-koden visas här så snart den valda anslutningen är redo." } }
      }
    },
    "The local mirror is ready on 127.0.0.1:%lld. Waiting for %@…": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Den lokala speglingen är redo på 127.0.0.1:%lld. Väntar på %@…" } }
      }
    },
    "This device loses owner access immediately. Pair it again with a new code if you want to restore access.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Den här enheten förlorar ägaråtkomsten omedelbart. Parkoppla den igen med en ny kod om du vill återställa åtkomsten." } }
      }
    },
    "Threading could not read its paired-device Keychain item. It will not overwrite that item or issue a credential it cannot preserve.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Threading kunde inte läsa nyckelringsposten för parkopplade enheter. Posten skrivs inte över och en autentiseringsuppgift som inte kan bevaras utfärdas inte." } }
      }
    },
    "App-owned transient surfaces with themed chrome, Escape, focus return, and accessibility.": {
      "localizations": {
        "sv": { "stringUnit": { "state": "translated", "value": "Appägda tillfälliga ytor med temaanpassat utseende, Escape, återställd fokus och tillgänglighet." } }
      }
    },
