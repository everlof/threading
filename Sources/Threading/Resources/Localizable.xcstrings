    },
    "Unschedule this message": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Avschemalägg det här meddelandet" } } }
    },
    "Messages scheduled to be sent later": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Meddelanden schemalagda att skickas senare" } } }
    },
    "%@ · in %@": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ · om %@" } } }
    },
    "Missed while Threading was closed": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Missades medan Threading var stängt" } } }
    },
    "There is nothing here to schedule.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Det finns inget här att schemalägga." } } }
    },
    "%lld messages are already scheduled here. Send or remove one first.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld meddelanden är redan schemalagda här. Skicka eller ta bort ett först." } } }
    },
    "%lld messages are already scheduled. Send or remove one first.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld meddelanden är redan schemalagda. Skicka eller ta bort ett först." } } }
    },
    "That moment has already passed.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den tidpunkten har redan passerat." } } }
    },
    "Scheduled messages could not be saved, so this was not taken.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Schemalagda meddelanden kunde inte sparas, så det här togs inte emot." } } }
    },
    "Start this session later": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Starta den här sessionen senare" } } }
    },
    "Write the brief first.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skriv uppdraget först." } } }
    },
    "Images can't be scheduled — they are temporary files.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Bilder kan inte schemaläggas — de är tillfälliga filer." } } }
    },
    "Couldn't schedule this": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kunde inte schemalägga det här" } } }
    },
    "ScheduledMessageStripView": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "ScheduledMessageStripView" } } }
    },
    "Messages waiting for a later moment, above the queue waiting only for this turn. Ordered by the clock rather than by hand, so no row drags — click one to open it, ✕ to unschedule it, and Send now where the clock has stopped being the thing to say.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Meddelanden som väntar på en senare tidpunkt, ovanför kön som bara väntar på den här turen. Ordnade efter klockan snarare än för hand, så ingen rad dras — klicka på en för att öppna den, ✕ för att avschemalägga den, och Skicka nu där klockan har slutat vara det som är värt att säga." } } }
    },
    "Scheduled sends": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Schemalagda utskick" } } }
    },
    "If the window has not reset": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Om fönstret inte har nollställts" } } }
    },
    "  (default)": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "  (standard)"
          }
        }
      }
    },
