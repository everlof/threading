    "Provider-reported cost where available; catalog estimate otherwise.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Leverantörsrapporterad kostnad där den finns; annars kataloguppskattning." } } } },
    "Provider-neutral charts and the retained dashboard they compose.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Leverantörsneutrala diagram och den beständiga instrumentpanel de bygger upp." } } } },
