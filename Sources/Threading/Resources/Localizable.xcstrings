    },
    "Scheduled session cancelled.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den schemalagda sessionen avbröts." } } }
    },
    "Scheduled session started now.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den schemalagda sessionen startades nu." } } }
    },
    "ScheduledSessionPlaceholderView": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "ScheduledSessionPlaceholderView" } } }
    },
    "The frozen brief and launch decisions for a conversation waiting on its trigger. Start now and Cancel schedule exercise the two exits.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Det låsta uppdraget och startvalen för en konversation som väntar på sitt villkor. Starta nu och Avbryt schemaläggning provar de två utgångarna." } } }
    },
    "Session is scheduled to start automatically": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Sessionen är schemalagd att starta automatiskt" } } }
    },
    "Brief": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Uppdrag" } } }
    },
    "Start now": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Starta nu" } } }
