    },
    "The update for %@ changed after it was reviewed. Check what it now asks for and try again.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringen för %@ har ändrats efter att den granskats. Kontrollera vad den nu efterfrågar och försök igen."
          }
        }
      }
    },
    "The update for %@ declares data version %lld, but the installed package already uses %lld. Data versions cannot decrease.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
