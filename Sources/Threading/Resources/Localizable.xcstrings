        }
      }
    },
    "The anatomy inside a hover popover: a bounded preview, one group rule, and full-cell action rows." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anatomin inuti en hovringspopover: en avgränsad förhandsvisning, en gruppregel och åtgärdsrader i full bredd."
          }
        }
      }
