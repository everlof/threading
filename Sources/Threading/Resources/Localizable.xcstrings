    "Cost, tokens, provider coverage, and 180 days of observed limit history.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kostnad, tokens, leverantörstäckning och 180 dagar av observerad gränshistorik." } } } },
