{
  "sourceLanguage": "en",
  "strings": {
    "%": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "%"}}}},
    "%1$@ must be a whole number from %2$lld to %3$lld.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "%1$@ måste vara ett heltal från %2$lld till %3$lld."}}}},
    "Add Alert": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Lägg till avisering"}}}},
    "Add Limit": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Lägg till gräns"}}}},
    "Add Reserve": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Lägg till reserv"}}}},
    "Add Window": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Lägg till fönster"}}}},
    "Always leave": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Lämna alltid"}}}},
    "Budget": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Budget"}}}},
    "Choose how much of the %@ window Threading may spend inside one rolling window.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Välj hur stor del av fönstret %@ som Threading får använda inom ett rullande fönster."}}}},
    "Choose how often the %@ window should notify you as it fills.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Välj hur ofta fönstret %@ ska avisera dig när det fylls."}}}},
    "Choose the point in the %@ window when Threading should notify you.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Välj vid vilken punkt i fönstret %@ som Threading ska avisera dig."}}}},
    "Reserve this share of %@ usage for the owner; Threading may use the rest.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Reservera denna andel %@-användning åt ägaren; Threading får använda resten."}}}},
    "Custom alert…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad avisering…"}}}},
    "Custom repeating alert": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad upprepad avisering"}}}},
    "Custom repeating alert…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad upprepad avisering…"}}}},
    "Custom reserved share": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad reserverad andel"}}}},
    "Custom reserved share…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad reserverad andel…"}}}},
    "Custom shorter window": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassat kortare fönster"}}}},
    "Custom shorter window…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassat kortare fönster…"}}}},
    "Custom spending limit": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad användningsgräns"}}}},
    "Custom spending limit…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad användningsgräns…"}}}},
    "Custom usage alert": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassad användningsavisering"}}}},
    "Custom values…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Anpassade värden…"}}}},
    "Enter a whole percentage from 1% to 99%.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Ange ett helt procenttal från 1 % till 99 %."}}}},
    "Enter exact percentages for alerts, spending limits, rolling windows, or reserved usage.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Ange exakta procenttal för aviseringar, användningsgränser, rullande fönster eller reserverad användning."}}}},
    "Every": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Varje"}}}},
    "Keep under": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Håll under"}}}},
    "Keep usage under percentage": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Håll användningen under procenttalet"}}}},
    "Leaves this share of what the clock has released unused; Threading may use the rest.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Lämnar den här andelen av det som klockan har frigjort oanvänd; Threading får använda resten."}}}},
    "Notify at percentage": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Avisera vid procenttal"}}}},
    "Notify at": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Avisera vid"}}}},
    "Repeat every percentage": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Upprepa efter varje procentandel"}}}},
    "Reserved percentage": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Reserverat procenttal"}}}},
    "Rolling-window budget percentage": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Budgetprocent för rullande fönster"}}}},
    "Rolling-window length in hours": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Det rullande fönstrets längd i timmar"}}}},
    "Threading will hold back work it starts on its own after the %@ window reaches this line. Turns you send still go through.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Threading pausar arbete som det startar på eget initiativ efter att fönstret %@ når den här gränsen. Turer du skickar går fortfarande igenom."}}}},
    "Whole numbers only: 1%%–99%% across a rolling window of %1$lld–%2$lld hours.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Endast heltal: 1 %%–99 %% över ett rullande fönster på %1$lld–%2$lld timmar."}}}},
    "hours": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "timmar"}}}},
    "AgentWorkloadAnalyzerView": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "AgentWorkloadAnalyzerView"}}}},
    "The spectrum material's workload reading in place of the brand: seven fixed bands off the shared AgentIntensity envelope, the working count in one-bit figures, and MAX at provider-relative top effort. Decorative, and it drives no timer while hidden, idle, or under Reduce Motion.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Spektrummaterialets avläsning av arbetsbelastning i stället för varumärket: sju fasta band från den delade AgentIntensity-kurvan, antalet arbetande sessioner i enbitssiffror och MAX vid leverantörsrelativ toppinsats. Dekorativ, och den driver ingen timer medan den är dold, overksam eller under Reducera rörelse."}}}},
    "ScreenshotReportDropTargetView": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "ScreenshotReportDropTargetView"}}}},
    "The Threading mark drawn live: brand threads under System, the theme's accent under a style. Rest, then Weave, Breathe and Orbit from left to right; Weave is held at one box-tumble pose, Preview plays the whole route, and Replay shows the launch stitch.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Threading-märket ritat direkt: varumärkestrådar under System, temats accent under en stil. Vila, sedan Väv, Andas och Kretsa från vänster till höger; Väv hålls i en pose mitt i lådrotationen, Förhandsvisa spelar hela förloppet och Spela upp igen visar startsömmen."}}}},
    "The native titlebar's accepted-image state: a quiet wash and one exact sentence beside the traffic lights. It is transient, has no resting surface, and never takes titlebar hit-testing.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Den inbyggda titelradens läge för en godkänd bild: en stillsam toning och en exakt mening bredvid trafikljusen. Det är tillfälligt, har ingen vilande yta och tar aldrig titelradens träfftestning."}}}},
    "%@ · %@ · Preview": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "%@ · %@ · Förhandsvisning"}}}},
    "A view-only link can watch output while this shell is running. A full-control link can start the shell and run commands as your Mac user. The project folder is only the starting directory, not a security boundary. Neither grant can approve AI permissions or manage Threading.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "En skrivskyddad länk kan se utdata medan skalet körs. En länk med full kontroll kan starta skalet och köra kommandon som din Mac-användare. Projektmappen är bara startkatalogen, inte en säkerhetsgräns. Ingen av behörigheterna kan godkänna AI-behörigheter eller hantera Threading."}}}},
    "Choose Simulator": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Välj simulator"}}}},
    "Capture Simulator": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Ta bild av simulator"}}}},
    "Copy Full-Control Link": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Kopiera länk med full kontroll"}}}},
    "Once a day, Threading asks GitHub about the app, npm about installed Claude, Codex, Grok and OpenCode tools, and cursor.com about installed Cursor. The app request carries the version you are on and your macOS version, the way any download does. The agent requests include no account, project, session or installed version. Neither carries an identifier or anything about your projects. Turn the check off in General and nothing is asked.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "En gång om dagen frågar Threading GitHub om appen, npm om installerade verktyg för Claude, Codex, Grok och OpenCode samt cursor.com om installerade Cursor. Appförfrågan innehåller versionen du kör och din macOS-version, precis som vilken nedladdning som helst. Förfrågningarna för agenter innehåller inget konto, projekt, ingen session och ingen installerad version. Ingen av dem bär en identifierare eller något om dina projekt. Stäng av kontrollen under Allmänt så skickas inga förfrågningar."}}}},
    "Once a day, Threading checks GitHub for the app and each installed agent's official release source. App updates use Sparkle after you agree; agent updates run in a visible terminal only when you choose Update. Off stops both background checks — Help ▸ Check for Updates… still checks the app.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "En gång om dagen kontrollerar Threading GitHub för appen och den officiella utgivningskällan för varje installerad agent. Appuppdateringar använder Sparkle efter att du har godkänt; agentuppdateringar körs i en synlig terminal först när du väljer Uppdatera. Av stoppar båda bakgrundskontrollerna — Hjälp ▸ Sök efter uppdateringar… kontrollerar fortfarande appen."}}}},
    "Adopt an iOS Simulator device in this session's right panel.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Adoptera en iOS-simulatorenhet i sessionens högra panel."}}}},
    "Install a built .app and launch it on the adopted panel device.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Installera en byggd .app och starta den på den adopterade panelenheten."}}}},
    "Install and launch app": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Installera och starta app"}}}},
    "iOS Simulator": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "iOS-simulator"}}}},
    "Let agents build into and inspect an adopted Simulator in the right panel.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Låt agenter bygga till och granska en adopterad simulator i den högra panelen."}}}},
    "Preparing %@…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Förbereder %@…"}}}},
    "Prepare Simulator": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Förbered simulator"}}}},
    "Refresh Simulator": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Uppdatera simulator"}}}},
    "Return the current pixels from the same Simulator shown in the panel.": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Returnera de aktuella bildpunkterna från samma simulator som visas i panelen."}}}},
    "Share Terminal…": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Dela terminal…"}}}},
    "Simulator screen": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Simulatorskärm"}}}},
