    "Coordinate this project\nStart and guide chats\nStop when the brief is done": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Samordna projektet\nStarta och vägled chattar\nSluta när uppdraget är klart"}}}},
    "Make Manager": {"extractionState": "manual", "localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Gör till manager"}}}},
