      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "terminalmarkering" } } }
    },
    "That session is no longer in Threading's sidebar.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den sessionen finns inte längre i Threadings sidofält." } } }
    },
    "That session was archived before this was due.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den sessionen arkiverades innan det här skulle skickas." } } }
    },
    "Waiting for the session to be free": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Väntar på att sessionen ska bli ledig" } } }
    },
    "Its agent is not running. Threading will not type into a terminal it cannot see.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess agent körs inte. Threading skriver inte i en terminal det inte kan se." } } }
    },
    "Its agent could not be started.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess agent kunde inte startas." } } }
    },
    "Its project is no longer in Threading.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess projekt finns inte längre i Threading." } } }
    },
    "Its folder is missing: %@": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess mapp saknas: %@" } } }
    },
    "Its checkout for %@ is gone.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess utcheckning för %@ är borta." } } }
    },
    "Its agent surface no longer has Threading session tools.": {
      "extractionState": "manual",
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess agentyta har inte längre Threadings sessionsverktyg." } } }
    },
    "Its session could not be created.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dess session kunde inte skapas." } } }
    },
    "It was typed into the session, which never confirmed a turn started.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Det skrevs in i sessionen, som aldrig bekräftade att en tur började." } } }
    },
    "A scheduled message was sent": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ett schemalagt meddelande skickades" } } }
    },
    "A scheduled message could not be sent": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ett schemalagt meddelande kunde inte skickas" } } }
    },
    "In an hour": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Om en timme" } } }
    },
    "Tomorrow at %@": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "I morgon %@" } } }
    },
    "Monday at %@": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "På måndag %@" } } }
    },
    "When the %@ window resets": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "När %@-fönstret nollställs" } } }
    },
    "Send it anyway": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skicka det ändå" } } }
    },
    "Wait once for the new reset": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Vänta en gång på den nya nollställningen" } } }
    },
    "Wait until the window actually resets": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Vänta tills fönstret faktiskt nollställs" } } }
    },
    "Sends at the time you picked. If the reading was stale the agent meets the limit immediately and the turn is spent for nothing.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skickar vid tiden du valde. Om avläsningen var inaktuell möter agenten gränsen omedelbart och turen förbrukas i onödan." } } }
    },
    "Checks again when the moment arrives, stands aside once if the window has moved, then sends.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrollerar igen när stunden kommer, står över en gång om fönstret har flyttats, och skickar sedan." } } }
    },
    "Keeps waiting until the window frees. Most likely to land on a fresh window, and can send noticeably later than the time you picked.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Fortsätter vänta tills fönstret frigörs. Störst chans att landa i ett färskt fönster, och kan skicka märkbart senare än tiden du valde." } } }
    },
    "Send later": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skicka senare" } } }
    },
    "Custom time…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Egen tid…" } } }
    },
    "When a conversation finishes…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "När en konversation blir klar…" } } }
    },
    "No conversations with reliable finish signals are working.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inga konversationer med tillförlitliga slutsignaler arbetar." } } }
    },
    "When a conversation finishes": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "När en konversation blir klar" } } }
    },
    "Search working conversations": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Sök bland arbetande konversationer" } } }
    },
    "Working conversations": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Arbetande konversationer" } } }
    },
    "Choose the conversation whose current turn should finish first.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Välj konversationen vars pågående tur ska bli klar först." } } }
    },
    "Choose among %lld conversations whose current turns are still running.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Välj bland %lld konversationer vars pågående turer fortfarande körs." } } }
    },
