    },
    "Install an extension included with Threading, or import a .threadingextension package or unpacked development directory. Every new package remains disabled until you enable it; Git source links are for inspection, never cloned or built." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera ett tillägg som ingår i Threading, eller importera ett .threadingextension-paket eller en uppackad utvecklingsmapp. Varje nytt paket förblir inaktiverat tills du aktiverar det; Git-länkar till källkoden är till för granskning och klonas eller byggs aldrig."
          }
        }
      }
    },
    "Install an extension included with Threading, or import a .threadingextension package or unpacked development directory. Every package is reviewed before it is copied and remains disabled until you enable it; Git source links are for inspection, never cloned or built." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera ett tillägg som ingår i Threading, eller importera ett .threadingextension-paket eller en uppackad utvecklingsmapp. Varje paket granskas innan det kopieras och förblir inaktiverat tills du aktiverar det. Git-länkarna är till för granskning; Threading klonar eller bygger aldrig källkoden."
          }
        }
      }
    },
