    "Observed limits, resets, projections, and expiring banked resets.": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Observerade gränser, återställningar, prognoser och sparade återställningar som löper ut." } } } },
    "Output": { "extractionState": "manual", "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Utdata" } } } },
