            "state" : "translated",
            "value" : "Det når %@"
          }
        }
      }
    },
    "It then prefers a direct encrypted connection. TURN is used only when direct network traversal cannot connect." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
