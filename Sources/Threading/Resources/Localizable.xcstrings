      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "I dag" } } }
    },
    "Tomorrow": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "I morgon" } } }
    },
    "Day": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dag" } } }
    },
    "Time": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tid" } } }
    },
    "No time left today.": {
