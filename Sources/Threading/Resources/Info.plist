<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Threading</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
		The release channel, injected like the version: scripts/release.sh passes
		THREADING_CHANNEL to xcodebuild archive, and a build made without it expands this to
		the empty string, which AppInfo.buildChannel reads as the dev channel. Deliberate —
		a local build must not be able to claim it is a release. See BuildChannel and
		docs/architecture/releasing.md.
	-->
	<key>ThreadingBuildChannel</key>
	<string>$(THREADING_CHANNEL)</string>
	<!--
		The automatic installer stamps the exact master commit it checked out and then reads this
		value back from the product before installation. Ordinary and shipping builds leave it
		empty; it is provenance for the local /Applications convergence loop, not a release version.
	-->
	<key>ThreadingSourceRevision</key>
	<string>$(THREADING_SOURCE_REVISION)</string>
	<!-- Account, rendezvous, and short-lived TURN control plane. Ordinary remote traffic uses
	     the negotiated peer path and does not transit this origin. -->
	<key>ThreadingControlPlaneURL</key>
	<string>https://remote.threading.codes</string>
	<!-- Where Report a Problem posts. Declared here, not as INFOPLIST_KEY_… in the project:
	     that build setting is only consulted when Xcode *generates* the Info.plist, and this
	     target ships an explicit one, so it was silently inert. Empty for every build that does
	     not inject it, which is deliberate — MacIssueReportSubmitter treats an empty value as no
	     endpoint, writes the report locally and posts nothing, so only a release archive can
	     reach production. scripts/release.sh supplies it and refuses to archive unless the host
	     presents a certificate. -->
	<key>ThreadingReportIntakeURL</key>
	<string>$(THREADING_REPORT_INTAKE_URL)</string>
	<key>ThreadingSentryDSN</key>
	<string>https://f1b176cf933e42e30fd125ed837301fd@o4512146237161472.ingest.de.sentry.io/4512147496501329</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSMainNibFile</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Open-licensed historical fallbacks live here; proprietary preferred faces are never
		 bundled. See Fonts/*/*-SOURCE.md for provenance and license. -->
	<key>ATSApplicationFontsPath</key>
	<!-- Xcode copies the font folder's files into the Resources root. -->
	<string>.</string>
	<!--
		Sparkle. Threading signs with its *own* EdDSA key — the public half below, whose
		private half lives in the login keychain under account `mjukis-threading` — so a
		compromised CI secret of one app can never sign an update for the other
		(docs/architecture/releasing.md, "Keys"). Losing that key means no installed copy can
		ever be updated again; back it up with `generate_keys -x <file> --account
		mjukis-threading`. scripts/generate_appcast.sh refuses to sign with a key that does not
		match this value, so key and plist cannot drift apart unnoticed.

		SUFeedURL is the stable feed and the single source of truth for it; nightly builds are
		routed to their own feed at runtime (UpdateFeedPolicy), never through this key.

		SUEnableAutomaticChecks is the *shipped default*; the user's choice overrides it through
		`AppSettings.automaticUpdateChecksEnabled`, which is what Settings ▸ General writes.
	-->
	<key>SUFeedURL</key>
	<string>https://github.com/everlof/threading/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>18EoXEv3Y17zr3HN/HUNBN7TqSy4RTLYhmNkZkJPon8=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!--
		The feed itself must carry a valid EdDSA signature, not just its enclosures — GitHub
		serving the appcast is part of the trusted surface otherwise — and an archive is
		verified before it is unpacked, so an archive-parsing bug cannot be reached by an
		unsigned download. Declaring SURequireSignedFeed here is also what makes
		generate_appcast sign the feed at all; scripts/generate_appcast.sh checks for that
		signature and fails the release without it.
	-->
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!--
		A project folder is chosen by the user, but the agent Threading launches in it is a child
		process, and TCC attributes a child's file access to the responsible parent. So the
		prompt for these locations says "Threading" no matter which agent actually reads the file.
		These strings are the only chance to say why before the user decides.
	-->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Threading needs access so the agent you run in a project on your Desktop can read and edit its files.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Threading needs access so the agent you run in a project in your Documents folder can read and edit its files.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Threading needs access so the agent you run in a project in your Downloads folder can read and edit its files.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Threading needs access so the agent you run in a project on this volume can read and edit its files.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Threading needs access so the agent you run in a project on this network volume can read and edit its files.</string>
	<!--
		macOS 15 brought iOS's local network privacy to the Mac, and TN3179's table is explicit:
		*every* Bonjour operation needs the privilege, registering a service included. So the
		first time Threading announces its LAN door, macOS asks — and without this string the
		alert has no sentence of ours in it. Measured on macOS 26.5: the same binary registered
		in about 0.7s when run from Terminal, which TN3179 exempts along with daemons and root,
		and registered nothing at all in 3.5s when launched as a launchd agent with an app
		identity, which is the path a person's copy of Threading actually takes.

		Listening for and accepting incoming TCP does *not* need the privilege, which is why
		remote access worked on the LAN before discovery existed and why a denial costs the
		announcement rather than the door.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Threading announces this Mac on your network so your paired iPhone can find it when its address changes.</string>
	<!--
		The service type Threading registers. TN3179 asks for it beside the usage description
		whenever an app registers or browses for a specific Bonjour service.
	-->
	<key>NSBonjourServices</key>
	<array>
		<string>_threading._tcp</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threading Window Configuration</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>codes.threading.window</string>
			</array>
		</dict>
		<!--
			Launch Services otherwise refuses these files before NSApplicationDelegate can
			see a Dock-icon drop. Rank None is the drop-only role: Threading accepts the
			URLs without appearing as an image or folder opener.
		-->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threading Drop Targets</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Threading Window Configuration</string>
			<key>UTTypeIconFile</key>
			<string></string>
			<key>UTTypeIdentifier</key>
			<string>codes.threading.window</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>threading</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
