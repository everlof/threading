    },
    "The agent stops and starts under the new account, then resumes this same conversation. Work currently in progress is interrupted.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Agenten stoppas och startas under det nya kontot och återupptar sedan samma konversation. Pågående arbete avbryts." } } }
    },
    "This controls how this chat responds when an account limit is reached.": {
