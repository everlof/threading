      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": " och " } } }
    },
    "%@ are here": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ är här" } } }
    },
    "%@ is here": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ är här" } } }
    },
