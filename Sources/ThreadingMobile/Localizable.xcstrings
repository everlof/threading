    },
    "Open %@ to answer.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Öppna %@ för att svara." } } }
    },
    "Play notification sounds": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Spela notisljud" } } }
    },
    "Requested agent updates": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Begärda agentuppdateringar" } } }
