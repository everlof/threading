    "Diagnostics never include messages, prompts, paths, notification text, device names or credentials. Optional details contain no stable device identifier." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostik innehåller aldrig meddelanden, prompter, sökvägar, notistexter, enhetsnamn eller inloggningsuppgifter. Valfria uppgifter innehåller ingen beständig enhetsidentifierare."
          }
        }
      }
    },
    "Direct" : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt"
          }
        }
      }
    },
    "Direct sends each key to the TUI. Compose writes in an iOS text area and sends the finished line at once. Each terminal remembers its own choice." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt skickar varje tangenttryckning till TUI:n. Skrivfält skriver i ett textområde i iOS och skickar hela raden på en gång. Varje terminal kommer ihåg sitt eget val."
          }
        }
      }
    },
