      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapport sparad"
          }
        }
      }
    },
    "Threading couldn’t reach the report service. The report is saved securely on this device and will be retried when the app is active.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threading kunde inte nå rapporttjänsten. Rapporten är säkert sparad på enheten och skickas igen när appen är aktiv."
          }
        }
      }
    },
    "Couldn’t send report": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att skicka rapporten"
          }
        }
      }
    },
