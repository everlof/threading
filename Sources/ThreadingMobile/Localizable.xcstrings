    },
    "%lld people are here": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld personer är här" } } }
    },
    "%lld people are typing…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld personer skriver…" } } }
    },
    "Another composer sent first. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En annan skrivyta skickade först. Ditt utkast finns kvar." } } }
    },
    "In-app collaboration": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Samarbete i appen" } } }
    },
    "Compose on this device…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skriv på den här enheten…" } } }
    },
    "Independent terminal drafts": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Oberoende terminalutkast" } } }
    },
    "People in open chats": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Personer i öppna chattar" } } }
    },
    "People in open sessions": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Personer i öppna sessioner" } } }
    },
    "Sending once…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skickar en gång…" } } }
    },
    "Send terminal line": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skicka terminalrad" } } }
    },
    "Presence stays inside the live session and never creates push notifications. Independent drafts prevent devices from mixing keystrokes; turn them off for direct terminal typing.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Närvaro stannar i den aktiva sessionen och skapar aldrig pushnotiser. Oberoende utkast hindrar enheter från att blanda tangenttryckningar; stäng av dem för att skriva direkt i terminalen." } } }
    },
    "The Mac rejected this line. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Mac-datorn avvisade raden. Ditt utkast finns kvar." } } }
    },
    "The Mac rejected this prompt. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Mac-datorn avvisade prompten. Ditt utkast finns kvar." } } }
    },
    "The session changed before this prompt could be sent. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Sessionen ändrades innan prompten kunde skickas. Ditt utkast finns kvar." } } }
    },
    "The session changed before this line could be sent. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Sessionen ändrades innan raden kunde skickas. Ditt utkast finns kvar." } } }
    },
    "These indicators stay inside the live chat and never create push notifications.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Indikatorerna stannar i den aktiva chatten och skapar aldrig pushnotiser." } } }
    },
    "This prompt could not be retried safely. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Prompten kunde inte skickas igen säkert. Ditt utkast finns kvar." } } }
    },
    "This line could not be retried safely. Your draft is still here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Raden kunde inte skickas igen säkert. Ditt utkast finns kvar." } } }
