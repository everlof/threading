      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Din Mac använder %@" } } }
    },
    "https://…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "https://…" } } }
    },
    "iOS asks for confirmation when you change an app icon. Threading never changes it automatically.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "iOS ber om bekräftelse när du ändrar appikonen. Threading ändrar den aldrig automatiskt." } } }
    },
    "%lld comments": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld kommentarer" } } }
    },
    "%lld references": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld referenser" } } }
    },
    "1 comment": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "1 kommentar" } } }
    },
    "1 reference": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "1 referens" } } }
    },
    "%@ needs your response": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ behöver ditt svar" } } }
    },
    "Agent needs my response": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Agenten behöver mitt svar" } } }
    },
    "Blocking questions and requests from people sound by default; routine updates stay quiet.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Blockerande frågor och förfrågningar från personer har ljud som standard; rutinuppdateringar är tysta." } } }
    },
    "Control request sent.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrollbegäran har skickats." } } }
    },
    "Input control updated.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inmatningskontrollen har uppdaterats." } } }
    },
