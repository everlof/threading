{
  "sourceLanguage": "en",
  "strings": {
    "Attachment unavailable": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Bilagan är inte tillgänglig" } } }
    },
    "Choose…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Välj…" } } }
    },
    "Custom extension surface": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Anpassad tilläggsyta" } } }
    },
    "Extension": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tillägg" } } }
    },
    "Extension panel": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tilläggspanel" } } }
    },
    "Extension panel unavailable": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tilläggspanelen är inte tillgänglig" } } }
    },
    "Images, documents, and HTML from this session will appear here.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Bilder, dokument och HTML från den här sessionen visas här." } } }
    },
    "Opening attachment…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Öppnar bilaga…" } } }
    },
    "Opening extension panel…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Öppnar tilläggspanel…" } } }
    },
    "Refresh extension panel": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Uppdatera tilläggspanel" } } }
    },
    "Running “%@”…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kör ”%@”…" } } }
    },
    "Loading…": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Läser in…" } } }
    },
    "The extension panel is not ready yet.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tilläggspanelen är inte klar än." } } }
    },
    "The extension restarted. Its current panel has been restored.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Tillägget startades om. Dess aktuella panel har återställts." } } }
    },
    "This captured attachment is no longer available on the Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den här sparade bilagan är inte längre tillgänglig på Mac-datorn." } } }
    },
    "This custom extension surface is available on your Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den här anpassade tilläggsytan är tillgänglig på din Mac." } } }
    },
    "This live panel is available on your Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Den här aktiva panelen är tillgänglig på din Mac." } } }
    },
    "End Demo": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Avsluta demo" } } }
    },
    "No Mac nearby? Try the demo.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ingen Mac i närheten? Prova demon." } } }
    },
    "This is the demo. Nothing here is connected.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Det här är demon. Inget här är anslutet." } } }
    },
    "Try the demo": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Prova demon" } } }
    },
    "Demo Mac": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Demo-Mac" } } }
    },
    "A shared link opens one chat and can never manage your Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "En delad länk öppnar en chatt och kan aldrig hantera din Mac." } } }
    },
    "Chats": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Chattar" } } }
    },
    "Open Threading → Settings → Remote Access to show its pairing code.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Öppna Threading → Inställningar → Fjärråtkomst för att visa parkopplingskoden." } } }
    },
    "Presence, typing and drafts": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Närvaro, skrivindikatorer och utkast" } } }
    },
    "Shared": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Delat" } } }
    },
    "Shared chat": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Delad chatt" } } }
    },
    "Your Mac": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Din Mac" } } }
    },
    "App icon": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Appikon" } } }
    },
    "Collaboration": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Samarbete" } } }
    },
    "Mac appearance": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Mac-utseende" } } }
    },
    "Not set": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inte inställt" } } }
    },
    "Off": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Av" } } }
    },
    "On": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "På" } } }
    },
    "On this iPhone": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "På denna iPhone" } } }
    },
    "Paste a pairing link, or a chat link someone shared with you.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Klistra in en parkopplingslänk eller en chattlänk som någon delat med dig." } } }
    },
    "Presence stays inside the live session. Independent drafts keep devices from mixing keystrokes in the same terminal.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Närvaro visas bara i livesessionen. Separata utkast hindrar enheter från att blanda tangenttryckningar i samma terminal." } } }
    },
    "Scan the code on your Mac": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skanna koden på din Mac" } } }
    },
    "Settings": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inställningar" } } }
    },
    "Support": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Support" } } }
    },
    "These iPhone preferences are available before you connect a Mac.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Dessa iPhone-inställningar är tillgängliga innan du ansluter en Mac." } } }
    },
    "Threading": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Threading" } } }
    },
    "Unavailable": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inte tillgängligt" } } }
    },
    "Use a link": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Använd en länk" } } }
    },
