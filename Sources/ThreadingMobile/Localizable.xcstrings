        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapport mottagen"
          }
        }
      }
    },
    "Thank you. Keep reference %@ if you contact us about this report.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack. Spara referensen %@ om du kontaktar oss om rapporten."
