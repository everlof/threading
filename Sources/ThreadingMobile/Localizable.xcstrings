    "This animation plays on your Mac.": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Den här animationen spelas på din Mac."}}}},
    "This movie plays on your Mac.": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Den här filmen spelas på din Mac."}}}},
    "This file previews on your Mac.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r filen f\u00f6rhandsvisas p\u00e5 din Mac."
          }
        }
      }
    },
    "%lld changed": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u00e4ndrade"
          }
        }
      }
    },
    "Attach a photo or file": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifoga ett foto eller en fil"
          }
        }
      }
    },
    "Photo Library": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildbibliotek"
          }
        }
      }
    },
    "Photo": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto"
          }
        }
      }
    },
    "Remove %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort %@"
          }
        }
      }
    },
    "%@, sending": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, skickas"
          }
        }
      }
    },
    "%@, attached": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bifogad"
          }
        }
      }
    },
    "%@, couldn’t be sent": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kunde inte skickas"
          }
        }
      }
    },
    "%@ couldn’t be sent to your Mac.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunde inte skickas till din Mac."
          }
        }
      }
    },
    "That is more text than one paste can carry.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är mer text än en inklistring rymmer."
          }
        }
      }
    },
    "There’s nothing on the clipboard to attach.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget i urklipp att bifoga."
          }
        }
      }
    },
    "There’s nothing on the clipboard to paste.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget i urklipp att klistra in."
          }
        }
      }
    },
    "That is as many files as one message can carry.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler filer än så får inte plats i ett meddelande."
          }
        }
      }
    },
    "Threading can’t send that file.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threading kan inte skicka den filen."
          }
        }
      }
    },
    "That file couldn’t be read.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kunde inte läsas."
          }
        }
      }
    },
    "The code under a Mac is the identity this iPhone pins. It is the same code that Mac prints under This Mac’s Identity, so the two can be compared by eye.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Koden under en Mac är identiteten som denna iPhone fäster. Det är samma kod som den Mac-datorn visar under Den här Mac-datorns identitet, så att de två kan jämföras med ögat." } } }
    },
    "Terminal": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Terminal" } } }
    },
    "Add to message": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Lägg till i meddelandet" } } }
    },
    "Insert into prompt": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Infoga i prompten" } } }
    },
    "Quoted terminal lines": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Citerade terminalrader" } } }
    },
    "Remove quoted lines": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Ta bort citerade rader" } } }
    },
    "1 line": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "1 rad" } } }
    },
    "%lld lines": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%lld rader" } } }
    },
    "Open in the Threading app. Works for someone on your Wi-Fi or tailnet.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna i Threading-appen. Fungerar för någon på ditt wifi eller ditt tailnet."
          }
        }
      }
    },
    "Also answers requests for you.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarar även på begäranden åt dig."
          }
        }
      }
    },
    "Can collaborate in “%@” and approve requests": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan samarbeta i “%@” och godkänna begäranden"
          }
        }
      }
    },
    "Can collaborate in “%@”": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan samarbeta i “%@”"
          }
        }
      }
    },
    "Can view “%@”": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan visa “%@”"
          }
        }
      }
    },
    "Choose what this person can do.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vad den här personen kan göra."
          }
        }
      }
    },
    "Couldn’t create link": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte skapa länk"
          }
        }
      }
    },
    "Reads the chat, writes nothing.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser chatten, skriver inget."
          }
        }
      }
    },
    "Start the chat first to share it view-only.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta chatten först för att dela den med endast visning."
          }
        }
      }
    },
    "Writes messages and steers the agent.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver meddelanden och styr agenten."
          }
        }
      }
    },
    "Agent prompt": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Agentprompt" } } }
    },
    "Automatic error screenshots": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Automatiska skärmbilder vid fel" } } }
    },
    "Check up on my iOS app usage.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Kontrollera min användning av iOS-appen." } } }
    },
    "Clear error screenshots": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Rensa skärmbilder från fel" } } }
    },
    "Connection reuse, metrics and checkups": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Återanvändning, mätvärden och kontroller" } } }
    },
    "Device checkups": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Enhetskontroller" } } }
    },
    "Error screenshots require their own switch, capture only the foreground Threading window, and stay in a three-image ring. A current screenshot is taken only when you explicitly ask the agent for one. Prompts, terminal output, paths, credentials and notification text are not logged.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Skärmbilder vid fel kräver en egen strömbrytare, fångar endast Threading-fönstret i förgrunden och sparas i en ring med tre bilder. En aktuell skärmbild tas bara när du uttryckligen ber agenten om en. Prompter, terminalutdata, sökvägar, inloggningsuppgifter och aviseringstext loggas inte." } } }
    },
    "Evidence": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Underlag" } } }
    },
    "Last failure": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Senaste fel" } } }
    },
    "Last upload": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Senaste överföring" } } }
    },
    "Local diagnostics": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Lokal diagnostik" } } }
    },
    "Local diagnostics is off by default and also has to be enabled on the paired Mac. Turning it off stops new requests immediately.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Lokal diagnostik är avstängd som standard och måste också aktiveras på den parkopplade Mac-datorn. Om du stänger av den stoppas nya förfrågningar omedelbart." } } }
    },
    "Not yet": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Inte ännu" } } }
    },
    "Paired Mac · local network": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Parkopplad Mac · lokalt nätverk" } } }
    },
    "Route": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Väg" } } }
    },
    "Saved error screenshots": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Sparade skärmbilder från fel" } } }
    },
    "The agent will say whether it used fresh or cached phone evidence.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Agenten anger om den använde färskt eller cachelagrat underlag från telefonen." } } }
    },
    "When enabled on this iPhone and its paired Mac, Threading can send bounded connection evidence over the local network. Turning it off stops new requests immediately.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "När funktionen är aktiverad på denna iPhone och dess parkopplade Mac kan Threading skicka begränsat anslutningsunderlag via det lokala nätverket. Om du stänger av den stoppas nya förfrågningar omedelbart." } } }
    },
    "%lld constrained": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "%lld begränsade"}}}},
    "%lld ready": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "%lld redo"}}}},
    "%lld unknown": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "%lld okända"}}}},
    "All Accounts · %lld": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Alla konton · %lld"}}}},
    "Next reset %@": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Nästa återställning %@"}}}},
    "Resets %@ · %@": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Återställs %@ · %@"}}}},
    "Shows this window's history below": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Visar fönstrets historik nedan"}}}},
    "Current capacity": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Aktuell kapacitet"}}}},
    "Consumption": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Förbrukning"}}}},
    "Loading current capacity…": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Läser in aktuell kapacitet …"}}}},
    "No current capacity": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Ingen aktuell kapacitet"}}}},
    "The Mac has not observed a provider limit window yet.": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Mac-datorn har ännu inte observerat något gränsfönster från en leverantör."}}}},
    "Accounts · %lld loaded": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Konton · %lld inlästa"}}}},
    "No active windows": {"localizations": {"sv": {"stringUnit": {"state": "translated", "value": "Inga aktiva fönster"}}}}
  },
  "version": "1.2"
