    },
    "Each row is reused / not reused. These fixed buckets show whether a shorter or longer hold would change the result without keeping a log.": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Varje rad visar återanvända / inte återanvända. De fasta intervallen visar om en kortare eller längre hålltid skulle ändra resultatet utan att spara en logg." } } }
    },
