      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka till Mac"
          }
        }
      }
    },
    "Share files…": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela filer…"
          }
        }
