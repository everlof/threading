      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "Du styr · andra tittar" } } }
    },
    "%@ asked %@ for input": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%1$@ bad %2$@ om synpunkter" } } }
    },
    "%@ asked for your input": {
      "localizations": { "sv": { "stringUnit": { "state": "translated", "value": "%@ bad om dina synpunkter" } } }
    },
