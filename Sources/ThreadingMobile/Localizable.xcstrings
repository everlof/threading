      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickad till din Mac"
          }
        }
      }
    },
    "A new %@ task is investigating this report in %@.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
