      }
    },
    "A deterministic debug surface for visual review and future UI tests." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En deterministisk felsökningsvy för visuell granskning och framtida gränssnittstester."
          }
        }
      }
    },
    "A long-press on a submitting snippet key inserts its text without running it." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett långtryck på en skickande textsnutt-tangent infogar texten utan att köra den."
          }
        }
      }
    },
    "A new %@ task is investigating this report in %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny uppgift i %@ undersöker rapporten i %@."
          }
        }
      }
    },
    "A screenshot can help explain visual problems, but it may contain code or chat content. You can preview and remove it before sharing." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En skärmbild kan hjälpa till att förklara visuella problem, men den kan innehålla kod eller chattinnehåll. Du kan förhandsgranska och ta bort den innan du delar."
          }
        }
      }
    },
    "A session can only move to another account for the same agent." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session kan bara flyttas till ett annat konto för samma agent."
          }
        }
      }
    },
    "A shared link opens one chat and can never manage your Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En delad länk öppnar en chatt och kan aldrig hantera din Mac."
