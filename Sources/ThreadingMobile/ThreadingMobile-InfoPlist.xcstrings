      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Approve one credential operation on your paired Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn en åtgärd med en inloggningsuppgift på din parkopplade Mac."
