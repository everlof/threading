    "%lld of these were written in the last few minutes, so something is probably building in them right now. Removing them will interrupt those builds.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld av dem skrevs till under de senaste minuterna, så något byggs antagligen i dem just nu. Om du tar bort dem avbryts de byggena."
          }
        }
      }
    },
    "%lld running sessions will be terminated. Saved conversations are not deleted.": {
      "extractionState": "stale",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld körande konversationer kommer att avslutas. Spara konversationer tas inte bort."
