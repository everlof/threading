<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode expands the build settings, then embeds the processed plist in __TEXT __info_plist.
	     A command-line tool in Contents/Helpers remains one file; no loose plist can drift from it. -->
	<key>CFBundleIdentifier</key>
	<string>codes.threading.ptyd</string>
	<key>CFBundleName</key>
	<string>threading-ptyd</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The local autoinstaller keeps both versions at 0.0.0, so its exact installed commit is
	     the generation. Shipping builds leave this empty and move the two versions instead. -->
	<key>ThreadingSourceRevision</key>
	<string>$(THREADING_SOURCE_REVISION)</string>
</dict>
</plist>
