                <dict>
                    <key>title</key><string>Bluetooth logs</string>
                    <key>symbol</key><string>antenna.radiowaves.left.and.right</string>
                    <key>detail</key><string>Capture a paired iPhone's Bluetooth packets</string>
                </dict>
            </dict>
        </array>
    </dict>
