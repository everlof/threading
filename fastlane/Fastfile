# ThreadingMobile's release automation: TestFlight builds, the App Store listing, and the App
# Store screenshots Marketeer renders. docs/architecture/releasing.md, "The iOS companion on
# TestFlight", records why each lane is shaped the way it is; credentials come from the untracked
# fastlane/.env it describes.

require "json"
require "open3"
require "shellwords"
require "digest"
require "fileutils"

default_platform(:ios)

# fastlane evaluates this file with fastlane/ as the working directory, where `__dir__` is ".",
# but runs actions such as deliver from the repository root. A relative path therefore means two
# different places, so every path is made absolute here, while "." still names fastlane/.
FASTLANE_DIRECTORY = File.expand_path(__dir__)
REPOSITORY = File.expand_path("..", FASTLANE_DIRECTORY)
PROJECT = File.join(REPOSITORY, "Threading.xcodeproj")
SCHEME = "ThreadingMobile"
APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
TEAM_ID = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
BUILD_DIRECTORY = File.join(REPOSITORY, "build", "testflight")
METADATA_DIRECTORY = File.join(FASTLANE_DIRECTORY, "metadata")
INTERNAL_GROUP = "MJUKIS"

MARKETEER_DOCUMENT = File.join(FASTLANE_DIRECTORY, "marketeer", "Threading.marketeer")
MARKETEER_EXPORT_DIRECTORY = File.join(REPOSITORY, "build", "app-store-screenshots")
MARKETEER_EXPORT_SIZES = %w[6.9 6.5 6.3 6.1].freeze
MARKETEER_BUNDLED_CLI = File.expand_path(
  "~/Library/Application Support/Threading/Plugins/Marketeer.bundle/Contents/Helpers/marketeer"
)
# The Marketeer document's slides in order, each named by the capture
# scripts/capture_marketing_ios.sh writes for it.
SCREENSHOT_CAPTURES = %w[01-sessions 02-claude-tui 03-claude-usage-menu 04-codex-tui 05-settings].freeze

platform :ios do
  desc "Archive ThreadingMobile in Release and upload it to TestFlight."
  desc "Requires a clean, tested checkout and compatible production service. changelog:\"…\" sets What to Test;"
  desc "wait:false returns before App Store Connect finishes processing."
  lane :beta do |options|
    revision = testflight_checkout
    receipt_path = options[:receipt] && File.expand_path(options[:receipt], REPOSITORY)
    receipt = read_release_receipt(receipt_path, revision) if receipt_path && File.exist?(receipt_path)
    build = receipt ? receipt.fetch("build").transform_keys(&:to_sym) : build_for_app_store
    validate_app_store_build(build)
    verify_testflight_checkout(revision)
    if receipt_path && !receipt
      receipt = {
        "revision" => revision, "build" => build, "state" => "validated",
        "ipa_sha256" => Digest::SHA256.file(build[:ipa]).hexdigest
      }
      write_release_receipt(receipt_path, receipt)
    end
    testflight_quality_gate
    verify_testflight_checkout(revision)
    sentry_ios("prepare", "--app", File.join(build[:archive], "Products/Applications/ThreadingMobile.app"),
               "--debug-files", File.join(build[:archive], "dSYMs"), "--output", build[:sentry_receipt])
    verify_testflight_checkout(revision)
    existing = receipt_path && uploaded_release_build(build)
    confirmed_upload = receipt && %w[uploaded submitted].include?(receipt.fetch("state"))
    if existing && !confirmed_upload
      UI.user_error!("This build number exists without a confirmed upload receipt; reconcile it in App Store Connect before retrying")
    end
    if confirmed_upload
      # Apple's build list may lag a successful upload. The durable receipt owns retry
      # behavior; wait for that exact build instead of uploading it a second time.
      UI.message("Resuming the recorded build #{build[:version]} (#{build[:number]})")
    else
      upload_to_testflight(
        api_key: asc_api_key,
        app_identifier: APP_IDENTIFIER,
        ipa: build[:ipa],
        changelog: options[:changelog] || default_changelog,
        distribute_external: false,
        uses_non_exempt_encryption: false,
        # Persist upload success before Apple's separately bounded processing wait. A timeout
        # there must resume this build, not leave a receipt that cannot prove its upload.
        skip_waiting_for_build_processing: !receipt_path.nil? || options[:wait] == false
      )
      if receipt_path
        receipt = receipt.merge("state" => "uploaded")
        write_release_receipt(receipt_path, receipt)
      end
    end
    wait_for_release_build(build) if receipt_path
    sentry_ios("deploy", "--release-file", build[:sentry_receipt], "--environment", "production")
    if receipt_path
      write_release_receipt(receipt_path, receipt.merge("state" => "uploaded"))
    end
  end

  desc "Submit the exact beta receipt's build to App Review; leave release after approval manual."
  desc "receipt:<path> is required. Re-running an already submitted build only verifies its state."
  lane :submit_review do |options|
    revision = testflight_checkout
    path = options[:receipt] && File.expand_path(options[:receipt], REPOSITORY)
    UI.user_error!("receipt:<path> from the beta lane is required") unless path
    receipt = read_release_receipt(path, revision)
    unless %w[uploaded submitted].include?(receipt.fetch("state"))
      UI.user_error!("Finish the beta lane before submitting this receipt")
    end
    build = receipt.fetch("build").transform_keys(&:to_sym)
    remote_build = wait_for_release_build(build)
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    version = app.get_app_store_versions.find { |entry| entry.version_string == build[:version] && entry.platform == "IOS" }
    UI.user_error!("No App Store version #{build[:version]}; run the metadata lane first") unless version
    accepted_states = %w[WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE PENDING_APPLE_RELEASE READY_FOR_SALE READY_FOR_DISTRIBUTION PROCESSING_FOR_APP_STORE]
    if accepted_states.include?(version.app_store_state)
      UI.user_error!("A different build is already submitted") unless version.get_build.id == remote_build.id
    end
    verify_testflight_checkout(revision)
    unless version.release_type == "MANUAL"
      version = version.update(attributes: { release_type: "MANUAL" })
    end
    UI.user_error!("Apple has not confirmed manual release") unless version.release_type == "MANUAL"
    unless accepted_states.include?(version.app_store_state)
      deliver(
        api_key: asc_api_key, app_identifier: APP_IDENTIFIER, platform: "ios",
        app_version: build[:version], build_number: build[:number].to_s,
        skip_binary_upload: true, skip_metadata: true, skip_screenshots: true,
        submit_for_review: true, automatic_release: false, force: true,
        precheck_include_in_app_purchases: false
      )
      version = Spaceship::ConnectAPI::AppStoreVersion.get(app_store_version_id: version.id)
      unless accepted_states.include?(version.app_store_state) && version.get_build.id == remote_build.id
        UI.user_error!("Apple has not confirmed submission of the recorded build: #{version.app_store_state}")
      end
    end
    UI.user_error!("Apple changed the manual release setting") unless version.release_type == "MANUAL"
    write_release_receipt(path, receipt.merge("state" => "submitted", "app_store_state" => version.app_store_state))
    UI.success("App Review: #{build[:version]} (#{build[:number]}) — #{version.app_store_state}")
  end

  desc "Build the IPA beta would upload and have App Store Connect validate it, uploading nothing."
  lane :validate do
    testflight_quality_gate
    validate_app_store_build(build_for_app_store)
  end

  desc "Update TestFlight description, privacy link and review instructions. Does not submit a build."
  lane :beta_metadata do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App Store Connect has no app for #{APP_IDENTIFIER}") unless app
    attributes = {
      description: File.read(File.join(FASTLANE_DIRECTORY, "beta_description.txt")).strip,
      feedbackEmail: review_information("email_address"),
      marketingUrl: metadata_text("en-US/marketing_url.txt"),
      privacyPolicyUrl: metadata_text("en-US/privacy_url.txt")
    }
    localization = app.get_beta_app_localizations.find { |entry| entry.locale == "en-US" }
    if localization
      Spaceship::ConnectAPI.patch_beta_app_localizations(
        localization_id: localization.id, attributes: attributes
      )
    else
      Spaceship::ConnectAPI.post_beta_app_localizations(
        app_id: app.id, attributes: attributes.merge(locale: "en-US")
      )
    end
    Spaceship::ConnectAPI.patch_beta_app_review_detail(app_id: app.id, attributes: {
      contactFirstName: review_information("first_name"),
      contactLastName: review_information("last_name"),
      contactPhone: review_information("phone_number"),
      contactEmail: review_information("email_address"),
      demoAccountRequired: false,
      notes: review_information("notes")
    })
  end

  desc "Create the internal TestFlight group if it is missing and add THREADING_INTERNAL_TESTERS."
  lane :internal_testers do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App Store Connect has no app for #{APP_IDENTIFIER}") unless app

    group = app.get_beta_groups(filter: { name: INTERNAL_GROUP })
               .find { |candidate| candidate.name == INTERNAL_GROUP }
    # Not app.create_beta_group: it always sends the public-link limit, and App Store Connect
    # refuses that attribute on an internal group.
    group ||= Spaceship::ConnectAPI.client.test_flight_request_client.post(
      "v1/betaGroups",
      {
        data: {
          type: "betaGroups",
          attributes: { name: INTERNAL_GROUP, isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { type: "apps", id: app.id } } }
        }
      }
    ).to_models.first
    UI.user_error!("#{INTERNAL_GROUP} exists but is an external group") unless group.is_internal_group

    testers = ENV.fetch("THREADING_INTERNAL_TESTERS", "").split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("Set THREADING_INTERNAL_TESTERS in fastlane/.env") if testers.empty?
    testers.each do |email|
      present = Spaceship::ConnectAPI.get_beta_testers(filter: { email: email, betaGroups: group.id })
                                     .to_models
      if present.any?
        UI.message("#{email} is already in #{INTERNAL_GROUP}")
      else
        Spaceship::ConnectAPI.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: email }
        )
        UI.success("Added #{email} to #{INTERNAL_GROUP}")
      end
    end
  end

  desc "Download the App Store listing into fastlane/metadata, replacing the local files."
  lane :download_metadata do
    require "deliver"
    require "deliver/setup"
    options = FastlaneCore::Configuration.create(
      Deliver::Options.available_options,
      {
        api_key: asc_api_key,
        app_identifier: APP_IDENTIFIER,
        platform: "ios",
        metadata_path: METADATA_DIRECTORY,
        skip_binary_upload: true,
        skip_screenshots: true,
        force: true
      }
    )
    Deliver::Runner.new(options)
    app = Deliver.cache[:app]
    version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    Deliver::Setup.new.generate_metadata_files(app, version, METADATA_DIRECTORY, options)
  end

  desc "Upload fastlane/metadata to the editable App Store version. No binary, no screenshots,"
  desc "and never a submission for review."
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      metadata_path: METADATA_DIRECTORY,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Place the iOS marketing captures in the Marketeer document and render the screenshots."
  desc "capture:true runs scripts/capture_marketing_ios.sh first; captures:<dir> uses existing"
  desc "captures. With neither, it renders the document as it stands."
  lane :screenshots do |options|
    captures = options[:captures] && File.expand_path(options[:captures], REPOSITORY)
    if options[:capture]
      output = File.join(
        REPOSITORY, ".build", "marketing-ios", "app-store-#{Time.now.strftime('%Y%m%d-%H%M%S')}"
      )
      sh(File.join(REPOSITORY, "scripts", "capture_marketing_ios.sh"), "--theme", "threading",
         "--output", output)
      captures = File.join(output, "screenshots")
    end

    if captures
      slides = marketeer_slides
      unless slides.count == SCREENSHOT_CAPTURES.count
        UI.user_error!("#{MARKETEER_DOCUMENT} has #{slides.count} slides but " \
                       "SCREENSHOT_CAPTURES names #{SCREENSHOT_CAPTURES.count}")
      end
      slides.zip(SCREENSHOT_CAPTURES).each do |slide, capture|
        image = File.join(captures, "#{capture}.png")
        UI.user_error!("Missing capture #{image}") unless File.file?(image)
        sh(marketeer_cli, "set-screenshot", MARKETEER_DOCUMENT,
           "--device", slide.fetch("devices").first.fetch("id"), image)
      end
    end

    render_marketing_screenshots(MARKETEER_EXPORT_DIRECTORY)
    UI.success("App Store screenshots: #{MARKETEER_EXPORT_DIRECTORY}")
  end

  desc "Read Apple's actual screenshot processing states for the editable App Store version."
  lane :screenshots_status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    version = app&.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("No editable iOS App Store version") unless version
    version.get_app_store_version_localizations.each do |localization|
      localization.get_app_screenshot_sets.each do |set|
        screenshots = set.app_screenshots || []
        UI.message(JSON.generate(
          locale: localization.locale, display: set.screenshot_display_type,
          complete: screenshots.count(&:complete?), total: screenshots.count,
          pending: screenshots.reject(&:complete?).map do |screenshot|
            {file: screenshot.file_name, delivery: screenshot.asset_delivery_state}
          end
        ))
      end
    end
  end

  desc "Render the screenshot upload plan; apply:true replaces screenshots and verifies processing."
  desc "The source document is never changed by an upload."
  lane :upload_screenshots do |options|
    render_marketing_screenshots(MARKETEER_EXPORT_DIRECTORY)
    UI.message("Replace editable-version screenshots from #{MARKETEER_EXPORT_DIRECTORY} " \
               "(#{MARKETEER_EXPORT_SIZES.join(', ')} inches); apply:true uploads them.")
    if options[:apply]
      deliver(
        api_key: asc_api_key,
        app_identifier: APP_IDENTIFIER,
        platform: "ios",
        screenshots_path: MARKETEER_EXPORT_DIRECTORY,
        skip_binary_upload: true,
        skip_metadata: true,
        overwrite_screenshots: true,
        screenshot_processing_timeout: 900,
        force: true,
        submit_for_review: false,
        run_precheck_before_submit: false
      )
    end
  end
end

# MARK: - App Store Connect credentials

def asc_credentials
  key_id = ENV.fetch("ASC_KEY_ID", "")
  issuer_id = ENV.fetch("ASC_ISSUER_ID", "")
  if key_id.empty? || issuer_id.empty?
    UI.user_error!("Set ASC_KEY_ID and ASC_ISSUER_ID in fastlane/.env " \
                   "(docs/architecture/releasing.md, \"The iOS companion on TestFlight\")")
  end
  key_path = File.expand_path(
    ENV.fetch("ASC_KEY_PATH", "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
  UI.user_error!("No App Store Connect API key at #{key_path}") unless File.file?(key_path)
  { key_id: key_id, issuer_id: issuer_id, key_path: key_path }
end

def asc_api_key
  credentials = asc_credentials
  app_store_connect_api_key(
    key_id: credentials[:key_id],
    issuer_id: credentials[:issuer_id],
    key_filepath: credentials[:key_path]
  )
end

# Lets xcodebuild create or renew the App Store profiles with the API key rather than with
# whichever Apple ID Xcode happens to be signed in to.
def xcodebuild_authentication
  credentials = asc_credentials
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", credentials[:key_path],
    "-authenticationKeyID", credentials[:key_id],
    "-authenticationKeyIssuerID", credentials[:issuer_id]
  ].shelljoin
end

# MARK: - Building

def sentry_ios(*arguments)
  sh("env", "SENTRY_ORG=threading", "SENTRY_PROJECT=threading-ios",
     File.join(REPOSITORY, "scripts/sentry-release.sh"), *arguments)
end

def testflight_quality_gate
  sentry_ios("check")
  sh(File.join(REPOSITORY, "scripts/ci.sh"))
  sh("node", File.join(REPOSITORY, "Service/ThreadingControlPlane/scripts/verify-production.mjs"))
end

def testflight_checkout
  status, result = Open3.capture2("git", "-C", REPOSITORY, "status", "--porcelain")
  UI.user_error!("TestFlight requires a clean checkout, including untracked files") unless result.success? && status.empty?
  revision, result = Open3.capture2("git", "-C", REPOSITORY, "rev-parse", "HEAD")
  UI.user_error!("Could not identify the TestFlight commit") unless result.success?
  revision.strip
end

def verify_testflight_checkout(revision)
  UI.user_error!("The checkout changed after TestFlight validation") unless testflight_checkout == revision
end

def validate_app_store_build(build)
  credentials = asc_credentials
  ENV["API_PRIVATE_KEYS_DIR"] = File.dirname(credentials[:key_path])
  sh("xcrun", "altool", "--validate-app", "--file", build[:ipa], "--type", "ios",
     "--apiKey", credentials[:key_id], "--apiIssuer", credentials[:issuer_id])
end

def metadata_text(path)
  text = File.read(File.join(METADATA_DIRECTORY, path)).strip
  UI.user_error!("Missing metadata: #{path}") if text.empty?
  text
end

def review_information(name)
  metadata_text("review_information/#{name}.txt")
end

# Archives with the build number after TestFlight's latest and exports for App Store Connect.
# The number is passed to xcodebuild rather than written into the project, so a release changes
# no tracked file, and the widget extension receives the same number as the app. Returns the exact
# IPA and archive pair so symbol upload can never accidentally choose another build's dSYMs.
def build_for_app_store
  api_key = asc_api_key
  build_number = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    initial_build_number: 0
  ).to_i + 1
  output = File.join(BUILD_DIRECTORY, build_number.to_s)
  authentication = xcodebuild_authentication
  archive = File.join(output, "ThreadingMobile.xcarchive")
  ipa = build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    destination: "generic/platform=iOS",
    derived_data_path: File.join(BUILD_DIRECTORY, "DerivedData"),
    archive_path: archive,
    output_directory: output,
    output_name: "ThreadingMobile",
    export_method: "app-store",
    export_team_id: TEAM_ID,
    export_options: {
      signingStyle: "automatic",
      teamID: TEAM_ID,
      uploadSymbols: true,
      manageAppVersionAndBuildNumber: false
    },
    # gym appends xcargs to the export command as well as the archive, so the authentication
    # reaches both from here; repeating it in export_xcargs makes xcodebuild refuse the export.
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number} #{authentication}",
    skip_profile_detection: true
  )
  plist = File.join(archive, "Products/Applications/ThreadingMobile.app/Info.plist")
  version = app_store_archive_version(plist)
  { ipa: ipa, archive: archive, sentry_receipt: File.join(output, "sentry-release.txt"),
    number: build_number, version: version }
end

def app_store_archive_version(plist)
  version, result = Open3.capture2("/usr/bin/plutil", "-extract", "CFBundleShortVersionString",
                                  "raw", "-expect", "string", "-o", "-", plist)
  version = version.strip
  unless result.success? && version.match?(/\A\d+(?:\.\d+){0,2}\z/)
    UI.user_error!("Archive has no valid marketing version")
  end
  version
end

# A receipt binds retries and review to the validated archive, never to Apple's changing "latest".
def write_release_receipt(path, receipt)
  FileUtils.mkdir_p(File.dirname(path))
  temporary = "#{path}.tmp"
  File.write(temporary, JSON.pretty_generate(receipt) + "\n", mode: "w", perm: 0600)
  File.rename(temporary, path)
end

def read_release_receipt(path, revision)
  receipt = JSON.parse(File.read(path))
  UI.user_error!("Release receipt belongs to another commit") unless receipt.fetch("revision") == revision
  ipa = receipt.fetch("build").fetch("ipa")
  unless File.file?(ipa) && Digest::SHA256.file(ipa).hexdigest == receipt.fetch("ipa_sha256")
    UI.user_error!("The recorded IPA is missing or changed")
  end
  receipt
end

def uploaded_release_build(build)
  asc_api_key
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App Store Connect has no app for #{APP_IDENTIFIER}") unless app
  Spaceship::ConnectAPI::Build.all(app_id: app.id, version: build.fetch(:version),
                                  build_number: build.fetch(:number).to_s, platform: "IOS").first
end

def wait_for_release_build(build)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 1800
  loop do
    remote = uploaded_release_build(build)
    return remote if remote && remote.processing_state == "VALID"
    if remote && %w[FAILED INVALID].include?(remote.processing_state)
      UI.user_error!("Apple rejected processing this build: #{remote.processing_state}")
    end
    UI.user_error!("Apple is still processing the recorded build; rerun to resume") if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
    sleep(30)
  end
end

def default_changelog
  commit = last_git_commit
  "#{commit[:abbreviated_commit_hash]} #{commit[:message].lines.first.to_s.strip}"
end

# MARK: - Marketeer

def marketeer_cli
  cli = File.expand_path(ENV.fetch("MARKETEER_CLI", MARKETEER_BUNDLED_CLI))
  unless File.executable?(cli)
    UI.user_error!("No Marketeer CLI at #{cli}; install the Marketeer plugin or set MARKETEER_CLI")
  end
  cli
end

def marketeer_slides
  output, status = Open3.capture2(marketeer_cli, "info", MARKETEER_DOCUMENT, "--json")
  UI.user_error!("marketeer info failed for #{MARKETEER_DOCUMENT}") unless status.success?
  JSON.parse(output).fetch("slides").sort_by { |slide| slide.fetch("index") }
end

def render_marketing_screenshots(directory)
  FileUtils.rm_rf(directory)
  locale_directory = File.join(directory, "en-US")
  # Apple's historical API names do not match current display diagonals: 6.1-inch
  # exports belong to APP_IPHONE_58, while APP_IPHONE_61 accepts 6.3-inch images.
  # Deliver maps pixel dimensions and verifies processing/checksums after upload.
  # The source is English-only. Legacy documents without localization metadata ignore
  # --locale-subfolders, so supply Deliver's locale directory explicitly.
  sh(marketeer_cli, "export", MARKETEER_DOCUMENT, "--out", locale_directory,
     "--sizes", MARKETEER_EXPORT_SIZES.join(","))
  expected = SCREENSHOT_CAPTURES.count * MARKETEER_EXPORT_SIZES.count
  actual = Dir.glob(File.join(locale_directory, "*.png")).count
  UI.user_error!("Expected #{expected} marketing screenshots, rendered #{actual}") unless actual == expected
end
