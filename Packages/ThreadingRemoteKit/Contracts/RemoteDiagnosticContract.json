{
  "schemaVersion": 1,
  "events": [
    { "name": "appLaunched", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "appBecameActive", "clientUploadSources": ["iOSClient"] },
    { "name": "hostPairingStarted", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "hostPairingSucceeded", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "hostPairingFailed", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "hostRemoved", "clientUploadSources": ["iOSClient"] },
    { "name": "hostRefreshStarted", "clientUploadSources": ["iOSClient", "browserClient"], "description": "One catalogue refresh began. trace joins its route attempts and final result." },
    { "name": "hostRefreshSucceeded", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "hostRefreshFailed", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "hostRouteStarted", "clientUploadSources": ["iOSClient", "browserClient"], "description": "One bounded way into a host began. This is a lifecycle record, never a request log." },
    { "name": "hostRouteProgress", "clientUploadSources": ["iOSClient", "browserClient"], "description": "One coarse, bounded stage inside an already-started route attempt." },
    { "name": "hostRouteEnded", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "hostListenerStarted", "clientUploadSources": [] },
    { "name": "hostListenerFailed", "clientUploadSources": [] },
    { "name": "hostDoorBound", "clientUploadSources": [], "description": "One door of the host listener set started answering on its addresses." },
    { "name": "hostDoorUnreachable", "clientUploadSources": [], "description": "One enabled door has nothing listening for it. The reason field says why." },
    { "name": "hostIdentityCreated", "clientUploadSources": [], "description": "The Mac minted the identity its listeners present. detail carries only a short fingerprint hash." },
    { "name": "hostIdentityReset", "clientUploadSources": [], "description": "The listener identity was replaced, unpairing devices without a rotation announcement." },
    { "name": "hostIdentityRotated", "clientUploadSources": [], "description": "A prepared successor identity became the identity the listeners present." },
    { "name": "hostDiscoveryRegistered", "clientUploadSources": [], "description": "The Mac began advertising its listener; origin is a hash, never an address or instance name." },
    { "name": "hostDiscoveryWithdrawn", "clientUploadSources": [] },
    { "name": "hostDiscoveryFound", "clientUploadSources": ["iOSClient"], "description": "A client saw a Threading service; peer is a pseudonym and no address or instance name is recorded." },
    { "name": "hostDiscoveryMatched", "clientUploadSources": ["iOSClient"] },
    { "name": "hostDiscoveryIgnored", "clientUploadSources": ["iOSClient"] },
    { "name": "relayConnected", "clientUploadSources": [] },
    { "name": "relayFailed", "clientUploadSources": [] },
    { "name": "authenticationRefused", "clientUploadSources": [] },
    { "name": "socketConnecting", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "socketConnected", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "socketEnded", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "socketFailed", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "socketReconnectScheduled", "clientUploadSources": ["iOSClient", "browserClient"], "description": "A failed live socket scheduled one bounded exponential retry." },
    { "name": "permissionDecisionSent", "clientUploadSources": ["iOSClient"] },
    { "name": "permissionDecisionReceived", "clientUploadSources": [] },
    { "name": "notificationAuthorization", "clientUploadSources": ["iOSClient"] },
    { "name": "apnsRegistrationSucceeded", "clientUploadSources": ["iOSClient"] },
    { "name": "apnsRegistrationFailed", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationRegistrationStarted", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationRegistrationSucceeded", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationRegistrationFailed", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationRegistrationReceived", "clientUploadSources": [] },
    { "name": "notificationReceived", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationSuppressed", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationPresented", "clientUploadSources": ["iOSClient"] },
    { "name": "notificationOpened", "clientUploadSources": ["iOSClient"] },
    { "name": "pushProviderAccepted", "clientUploadSources": [] },
    { "name": "pushProviderRefused", "clientUploadSources": [] },
    { "name": "issueReportOpened", "clientUploadSources": ["iOSClient"] },
    { "name": "issueReportExported", "clientUploadSources": ["iOSClient"] },
    { "name": "issueReportSubmissionStarted", "clientUploadSources": ["iOSClient"] },
    { "name": "issueReportSubmissionSucceeded", "clientUploadSources": ["iOSClient"] },
    { "name": "issueReportSubmissionDeferred", "clientUploadSources": ["iOSClient"] },
    { "name": "issueReportSubmissionFailed", "clientUploadSources": ["iOSClient"] },
    { "name": "attachmentPreviewFailed", "clientUploadSources": ["iOSClient"], "description": "A phone attachment preview attempt reached a terminal failure. kind and code remain structural tokens." },
    { "name": "uncleanExitDetected", "clientUploadSources": [] },
    { "name": "recoveryModeEntered", "clientUploadSources": [] },
    { "name": "diagnosticSharingStarted", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "diagnosticSharingStopped", "clientUploadSources": ["iOSClient", "browserClient"] },
    { "name": "diagnosticUploadReceived", "clientUploadSources": [] }
  ],
  "fields": [
    { "name": "trace", "validation": "token" },
    { "name": "providerTrace", "validation": "token" },
    { "name": "peer", "validation": "peerPseudonym" },
    { "name": "session", "validation": "sessionPseudonym" },
    { "name": "kind", "validation": "token" },
    { "name": "transport", "validation": "token" },
    { "name": "result", "validation": "token" },
    { "name": "code", "validation": "token" },
    { "name": "status", "validation": "token" },
    { "name": "environment", "validation": "token" },
    { "name": "protocolVersion", "validation": "unsignedInteger" },
    { "name": "minimumProtocolVersion", "validation": "unsignedInteger" },
    { "name": "capability", "validation": "token" },
    { "name": "surface", "validation": "token" },
    { "name": "enabledKindCount", "validation": "unsignedInteger" },
    { "name": "recordCount", "validation": "unsignedInteger" },
    { "name": "phase", "validation": "token", "description": "A fixed stage such as refresh, prepare, request, hello, or backoff." },
    { "name": "durationMS", "validation": "unsignedInteger" },
    { "name": "timeoutMS", "validation": "unsignedInteger" },
    { "name": "delayMS", "validation": "unsignedInteger" },
    { "name": "networkStage", "validation": "token", "description": "The coarse URL-loading phase reached by one bounded request." },
    { "name": "dnsMS", "validation": "unsignedInteger" },
    { "name": "tcpMS", "validation": "unsignedInteger" },
    { "name": "tlsMS", "validation": "unsignedInteger" },
    { "name": "serverWaitMS", "validation": "unsignedInteger" },
    { "name": "responseMS", "validation": "unsignedInteger" },
    { "name": "networkProtocol", "validation": "token", "description": "A fixed URLSession protocol token, never an address or URL." },
    { "name": "networkPath", "validation": "token", "description": "A fixed URLSession path token, never an interface name or URL." },
    { "name": "connectionReused", "validation": "token" },
    { "name": "attempt", "validation": "unsignedInteger" },
    { "name": "total", "validation": "unsignedInteger" },
    { "name": "wave", "validation": "token", "description": "The fixed pass of a bounded walk, such as route, address, or port." },
    { "name": "reason", "validation": "token" },
    { "name": "origin", "validation": "originDigest", "description": "A truncated address hash: origin- followed by twelve lowercase hexadecimal digits." },
    { "name": "detail", "validation": "token", "description": "A bounded machine token qualifying code or reason; never prose or a path." }
  ],
  "extraFields": [
    { "name": "deviceModel", "reportSources": ["iOSClient"] },
    { "name": "interfaceIdiom", "reportSources": ["iOSClient"] },
    { "name": "locale", "reportSources": ["iOSClient"] },
    { "name": "preferredLanguage", "reportSources": ["iOSClient"] },
    { "name": "timeZone", "reportSources": ["iOSClient"] },
    { "name": "lowPowerMode", "reportSources": ["iOSClient"] },
    { "name": "thermalState", "reportSources": ["iOSClient"] },
    { "name": "physicalMemoryMB", "reportSources": ["iOSClient"] },
    { "name": "availableStorageMB", "reportSources": ["iOSClient"] },
    { "name": "displayPoints", "reportSources": ["iOSClient"] },
    { "name": "displayScale", "reportSources": ["iOSClient"] },
    { "name": "applicationState", "reportSources": ["iOSClient"] },
    { "name": "connectionState", "reportSources": ["iOSClient"] },
    { "name": "connectionStateHistory", "reportSources": ["iOSClient"], "description": "A bounded ring of connection-state transitions behind the snapshot state." },
    { "name": "attachmentPreviewHistory", "reportSources": ["iOSClient"], "description": "A bounded ring of attachment-preview attempt outcomes using closed kind and outcome tokens." },
    { "name": "pairedHostCount", "reportSources": ["iOSClient"] },
    { "name": "visibleSessionCount", "reportSources": ["iOSClient"] },
    { "name": "activeScope", "reportSources": ["iOSClient"] },
    { "name": "activeCapability", "reportSources": ["iOSClient"] },
    { "name": "notificationAuthorization", "reportSources": ["iOSClient", "macOSHost"] },
    { "name": "notificationDelivery", "reportSources": ["iOSClient"] },
    { "name": "accessibilityAuthorization", "reportSources": ["macOSHost"] },
    { "name": "screenRecordingAuthorization", "reportSources": ["macOSHost"] },
    { "name": "remoteAccessEnabled", "reportSources": ["macOSHost"] },
    { "name": "appThemeID", "reportSources": ["macOSHost"] },
    { "name": "projectCount", "reportSources": ["macOSHost"] },
    { "name": "sessionCount", "reportSources": ["macOSHost"] },
    { "name": "extensionCount", "reportSources": ["macOSHost"] },
    { "name": "extensionCompanionCount", "reportSources": ["macOSHost"] },
    { "name": "agentAccountSummary", "reportSources": ["macOSHost"] },
    { "name": "previousLaunchClean", "reportSources": ["macOSHost"] },
    { "name": "automaticUpdateChecks", "reportSources": ["macOSHost"] },
    { "name": "simulatorStreaming", "reportSources": ["macOSHost"] },
    { "name": "crashLoopDecision", "reportSources": ["macOSHost"] },
    { "name": "launchLedger", "reportSources": ["macOSHost"] },
    { "name": "lastStartupCheckpoint", "reportSources": ["macOSHost"] },
    { "name": "metricKitDiagnostics", "reportSources": ["macOSHost"] },
    { "name": "metricKitWindow", "reportSources": ["macOSHost"] },
    { "name": "metricKitLastCrash", "reportSources": ["macOSHost"] },
    { "name": "mainThreadStalls", "reportSources": ["macOSHost"] }
  ]
}
