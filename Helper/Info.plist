<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Embedded into the executable with -sectcreate __TEXT __info_plist rather than shipped
	     beside it. Without a CFBundleIdentifier the sandbox cannot resolve a container and the
	     process traps at launch before main runs, which reads as the helper being broken. -->
	<key>CFBundleIdentifier</key>
	<string>se.mjukis.Skalman.extension-helper</string>
	<key>CFBundleName</key>
	<string>skalman-extension-helper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
</dict>
</plist>
