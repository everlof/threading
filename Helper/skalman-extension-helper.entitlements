<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The containment. Applied by the kernel before the helper's own code runs, and carried
	     across the execve into the extension. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The one grant. Read-only, and narrow enough that the exec of anything outside it fails
	     with EPERM regardless of what the helper was asked to run. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/Skalman/Extensions/Packages/</string>
	</array>

	<!-- Deliberately absent, each for a stated reason:
	     network.client            — this variant denies networking; see the -network variant.
	     network.server            — an extension must never accept an inbound connection.
	     files.user-selected.*     — an extension has no document surface, so an open panel in
	                                 its process would be a confused deputy.
	     keychain-access-groups    — secrets are brokered over the host connection.
	     home-relative read-write  — no extension gets a writable filesystem grant at all;
	                                 storage is brokered.
	     cs.disable-library-validation, cs.allow-jit
	                               — a package must not load unsigned code into its process. -->
</dict>
</plist>
