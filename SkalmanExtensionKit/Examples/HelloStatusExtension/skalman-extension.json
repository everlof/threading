{
  "formatVersion": 1,
  "identifier": "se.mjukis.hello-status",
  "name": "Hello Status",
  "version": "0.2.0",
  "runtime": "webAssembly",
  "executable": "bin/hello-status.wasm",
  "capabilities": [
    "commands",
    "panels",
    "mcp.tools",
    "settings",
    "services.provide",
    "ui.components",
    "host.projects.read",
    "host.sessions.read",
    "host.providers.read",
    "host.accounts.presentation.read",
    "appearance.provider-icons",
    "appearance.account-icons",
    "appearance.session-identity",
    "storage.kv",
    "storage.cache",
    "storage.secrets"
  ],
  "mcpTools": [
    {
      "id": "read-status",
      "title": "Read extension status",
      "description": "Return the current refresh count held by the Hello Status extension.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "id": "probe-secret-broker",
      "title": "Probe secret broker",
      "description": "Verify the host-brokered secret store with a temporary write/read/list/delete round trip.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "settings": {
    "pages": [
      {
        "id": "presentation",
        "title": "Presentation",
        "symbol": "lightbulb",
        "sections": [
          {
            "id": "row-status",
            "title": "Sidebar status",
            "fields": [
              {
                "id": "show-row-status",
                "title": "Show row status",
                "description": "Add the example status to project and session rows.",
                "control": {
                  "type": "toggle",
                  "defaultValue": true
                }
              },
              {
                "id": "status-label",
                "title": "Status label",
                "control": {
                  "type": "text",
                  "defaultValue": "Hello",
                  "placeholder": "Hello",
                  "maximumLength": 24
                }
              },
              {
                "id": "status-tone",
                "title": "Status tone",
                "control": {
                  "type": "choice",
                  "defaultValue": "positive",
                  "options": [
                    { "id": "neutral", "title": "Neutral" },
                    { "id": "positive", "title": "Positive" },
                    { "id": "warning", "title": "Warning" },
                    { "id": "negative", "title": "Negative" }
                  ]
                }
              },
              {
                "id": "maximum-rows",
                "title": "Maximum rows",
                "description": "Limit each project and session publication.",
                "control": {
                  "type": "integer",
                  "defaultValue": 10,
                  "minimum": 1,
                  "maximum": 50,
                  "step": 1
                }
              }
            ]
          }
        ]
      }
    ],
    "sections": [
      {
        "id": "startup",
        "page": "general",
        "title": "Startup",
        "fields": [
          {
            "id": "refresh-on-start",
            "title": "Refresh Hello Status on launch",
            "description": "Demonstrates a section contributed to an existing Settings page.",
            "control": {
              "type": "toggle",
              "defaultValue": false
            }
          }
        ]
      }
    ]
  },
  "services": [
    {
      "id": "status",
      "version": 1,
      "title": "Hello status",
      "description": "Returns the current Hello Status refresh count to another extension.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "refreshCount": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "serviceDependencies": []
}
