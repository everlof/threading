{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.codes/schemas/threading-project.schema.json",
  "title": "Threading project configuration",
  "description": "Versioned, repository-root commands discovered by Threading and run only after explicit user confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scripts"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
      "description": "Editor-facing location of this schema. Threading does not fetch it during discovery."
    },
    "version": {
      "const": 1
    },
    "scripts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "command"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable within the repository. IDs are case-sensitive and must be unique."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$",
          "description": "One shell command. Threading passes it to /bin/sh -lc after confirmation."
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "Optional SF Symbol name."
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:\\.|(?![/~])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000-\\u001F\\u007F]+)$",
          "default": ".",
          "description": "A path relative to the active execution checkout. Absolute paths, empty components, .. components, missing directories, and symlink escapes are rejected."
        },
        "previewURL": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https?://",
          "description": "Optional HTTP(S) URL without embedded credentials. The terminal receipt prints it; discovery never opens it."
        }
      }
    }
  }
}
