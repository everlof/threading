{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.local/schemas/chrome-reference-v2.json",
  "title": "Threading chrome reference manifest",
  "type": "object",
  "required": ["schema_version", "chrome_id", "target", "sources", "coverage", "crops", "reproductions"],
  "properties": {
    "schema_version": { "const": 2 },
    "chrome_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["platform", "release"],
      "properties": {
        "platform": { "type": "string" },
        "release": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page_url", "owner", "storage"],
        "properties": {
          "id": { "type": "string" },
          "page_url": { "type": "string" },
          "asset_url": { "type": "string" },
          "filename": { "type": "string" },
          "owner": { "type": "string" },
          "kind": { "enum": ["screenshot", "documentation_figure", "recreation"] },
          "storage": { "enum": ["remote_only", "redistributable", "project_owned"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "pdf_page": { "type": "integer", "minimum": 1 },
          "render_dpi": { "type": "integer", "minimum": 36 },
          "pixel_width": { "type": "integer", "minimum": 1 },
          "pixel_height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "coverage": { "type": "object" },
    "crops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "source_id", "rect"],
        "properties": {
          "id": { "type": "string" },
          "component": { "type": "string" },
          "source_id": { "type": "string" },
          "role": {
            "enum": ["comparison_target", "supporting_context"],
            "default": "comparison_target"
          },
          "rect": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "reproductions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "component", "fixture_id", "output", "reference_crop_ids",
          "comparison_mode", "review_status", "scale", "note"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component": { "type": "string" },
          "fixture_id": {
            "enum": [
              "retro-caption-glyph-family",
              "retro-scrollbar-family",
              "retro-menu-family"
            ]
          },
          "output": { "type": "string", "pattern": "^[^/]+\\.png$" },
          "reference_crop_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "comparison_mode": {
            "enum": ["component_fixture", "exact_reconstruction"]
          },
          "review_status": { "enum": ["pending", "mismatch", "verified"] },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string", "minLength": 1 },
          "reviewed_on": { "type": "string", "format": "date" },
          "tolerance": {
            "type": "object",
            "required": ["method"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "max_normalized_rgb_rmse": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
