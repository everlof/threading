{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.codes/schema/extension-secrets.schema.json",
  "title": "Threading extension Keychain broker values",
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "One extension-private secret name. UTF-8 encoding is capped at 512 bytes and control characters are rejected by the host."
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "value"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 87384,
          "description": "Opaque bytes, at most 64 KiB after base64 decoding."
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "value": {
          "type": ["string", "null"],
          "contentEncoding": "base64",
          "maxLength": 87384
        }
      }
    },
    "keyList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "keys"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "keys": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    }
  }
}
