{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skalman.invalid/schema/extension-manifest.schema.json",
  "title": "Skalman extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "identifier",
    "name",
    "version",
    "executable",
    "capabilities"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "description": "Manifest-relative path. Absolute paths and '.' or '..' components are invalid."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
