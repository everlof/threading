{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.codes/schema/extension-node.schema.json",
  "title": "Threading extension UI node",
  "$ref": "#/$defs/node",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "role"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "pattern": "\\S" },
            "role": {
              "enum": [
                "heading",
                "body",
                "detail",
                "code",
                "compactBody",
                "compactDetail"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "summary", "detail"],
          "properties": {
            "type": { "const": "disclosure" },
            "id": { "type": "string", "minLength": 1 },
            "summary": { "$ref": "#/$defs/node" },
            "detail": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/node" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "proceed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "base", "overlay"],
          "properties": {
            "type": { "const": "overlay" },
            "base": { "$ref": "#/$defs/node" },
            "overlay": { "$ref": "#/$defs/node" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "surface"],
          "properties": {
            "type": { "const": "customSurface" },
            "surface": { "$ref": "#/$defs/customSurface" },
            "accessibilityLabel": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference", "role"],
          "properties": {
            "type": { "const": "image" },
            "reference": { "$ref": "#/$defs/imageReference" },
            "role": {
              "enum": ["identity", "icon", "decoration"]
            },
            "accessibilityLabel": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "title", "role", "isEnabled"],
          "properties": {
            "type": { "const": "button" },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "title": { "type": "string", "pattern": "\\S" },
            "role": {
              "enum": ["standard", "primary", "destructive"]
            },
            "isEnabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "value",
            "accessibilityLabel",
            "role",
            "isEnabled"
          ],
          "properties": {
            "type": { "const": "textInput" },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "value": { "type": "string" },
            "placeholder": { "type": "string", "minLength": 1 },
            "accessibilityLabel": { "type": "string", "minLength": 1 },
            "role": { "enum": ["text", "search"] },
            "isEnabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "options", "accessibilityLabel", "isEnabled"],
          "properties": {
            "type": { "const": "picker" },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "selection": { "type": "string" },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "$ref": "#/$defs/pickerOption" }
            },
            "accessibilityLabel": { "type": "string", "minLength": 1 },
            "isEnabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "document"],
          "properties": {
            "type": { "const": "media" },
            "document": { "$ref": "#/$defs/mediaDocument" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "scene"],
          "properties": {
            "type": { "const": "scene" },
            "mediaDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "format", "accessibilityLabel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/mediaSource" },
        "format": {
          "type": "string",
          "minLength": 1,
          "description": "lottie, dot-lottie or animated-image today. A raw string rather than an enum so a newer manifest stays inspectable on an older host, which reports the format as uncarried instead of failing to decode the panel around it."
        },
        "playback": { "$ref": "#/$defs/mediaPlayback" },
        "transport": { "enum": ["host-owned", "hidden"] },
        "allowsFrameCopy": { "type": "boolean" },
        "accessibilityLabel": { "type": "string", "minLength": 1 },
        "preferredAspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "stateActionID": { "type": "string", "minLength": 1 }
      }
    },
    "mediaSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["extensionResource", "fileHandle", "sessionAttachment"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "description": "Never a path and never bytes. extensionResource is package-relative; fileHandle is an opaque handle from host.project.files.read; sessionAttachment is valid only inside attachments.preview@1."
    },
    "mediaPlayback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isPlaying": { "type": "boolean" },
        "loop": { "enum": ["once", "loop", "ping-pong"] },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 4 },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "background": { "enum": ["surface", "checkerboard", "transparent"] }
      }
    },
    "scene": { "$ref": "#/$defs/scene" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "role"],
          "properties": {
            "type": { "const": "status" },
            "text": { "type": "string", "pattern": "\\S" },
            "role": {
              "enum": ["neutral", "positive", "warning", "negative"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "divider" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spacing"],
          "properties": {
            "type": { "const": "spacer" },
            "spacing": {
              "$ref": "#/$defs/spacing"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "flexibleSpacer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "axis", "spacing", "children"],
          "properties": {
            "type": { "const": "stack" },
            "axis": {
              "enum": ["horizontal", "vertical"]
            },
            "spacing": {
              "$ref": "#/$defs/spacing"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    },
    "spacing": {
      "enum": ["none", "tight", "small", "medium", "large"]
    },
    "pickerOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "title", "isEnabled"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "isEnabled": { "type": "boolean" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibilityLabel", "preferredAspectRatio", "items"],
      "properties": {
        "accessibilityLabel": { "type": "string", "minLength": 1 },
        "preferredAspectRatio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        },
        "hierarchy": { "$ref": "#/$defs/sceneHierarchy" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/sceneItem" }
        }
      }
    },
    "sceneItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frame",
        "shape",
        "color",
        "isEnabled",
        "isSelected"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parentID": { "type": "string", "minLength": 1, "maxLength": 256 },
        "frame": { "$ref": "#/$defs/sceneRect" },
        "shape": {
          "enum": ["rectangle", "roundedRectangle", "ellipse"]
        },
        "color": {
          "enum": [
            "neutral",
            "accent",
            "positive",
            "warning",
            "negative",
            "category1",
            "category2",
            "category3",
            "category4",
            "category5",
            "category6"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "accessibilityLabel": { "type": "string", "minLength": 1 },
        "accessibilityValue": { "type": "string", "minLength": 1 },
        "actionID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "isEnabled": { "type": "boolean" },
        "isSelected": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["label"] },
        { "required": ["accessibilityLabel"] }
      ]
    },
    "sceneHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootID"],
      "properties": {
        "rootID": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sceneRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "customSurface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "shaderResource",
            "fragmentFunction",
            "preferredFramesPerSecond",
            "inputs"
          ],
          "properties": {
            "type": { "const": "metal" },
            "shaderResource": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/).+\\.metal$"
            },
            "fragmentFunction": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "preferredFramesPerSecond": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "inputs": {
              "type": "array",
              "maxItems": 8,
              "items": { "$ref": "#/$defs/surfaceInput" }
            }
          }
        }
      ]
    },
    "surfaceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "value": { "$ref": "#/$defs/surfaceScalar" }
      }
    },
    "surfaceScalar": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "constant" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "signal", "mapping"],
          "properties": {
            "type": { "const": "signal" },
            "signal": {
              "enum": ["active-account.usage-remaining"]
            },
            "mapping": { "$ref": "#/$defs/scalarMapping" }
          }
        }
      ]
    },
    "scalarMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputMinimum",
        "inputMaximum",
        "outputMinimum",
        "outputMaximum",
        "curve",
        "fallback"
      ],
      "properties": {
        "inputMinimum": { "type": "number" },
        "inputMaximum": { "type": "number" },
        "outputMinimum": { "type": "number" },
        "outputMaximum": { "type": "number" },
        "curve": {
          "enum": ["linear", "easeIn", "easeOut", "easeInOut"]
        },
        "fallback": { "type": "number" }
      }
    },
    "imageReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "identifier"],
          "properties": {
            "type": { "const": "hostAsset" },
            "identifier": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "extensionResource" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "systemSymbol" },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
