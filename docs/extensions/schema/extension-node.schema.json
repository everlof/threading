{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skalman.invalid/schema/extension-node.schema.json",
  "title": "Skalman extension UI node",
  "$ref": "#/$defs/node",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "role"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" },
            "role": {
              "enum": [
                "heading",
                "body",
                "detail",
                "code",
                "compactBody",
                "compactDetail"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "proceed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "base", "overlay"],
          "properties": {
            "type": { "const": "overlay" },
            "base": { "$ref": "#/$defs/node" },
            "overlay": { "$ref": "#/$defs/node" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "surface"],
          "properties": {
            "type": { "const": "customSurface" },
            "surface": { "$ref": "#/$defs/customSurface" },
            "accessibilityLabel": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference", "role"],
          "properties": {
            "type": { "const": "image" },
            "reference": { "$ref": "#/$defs/imageReference" },
            "role": {
              "enum": ["identity", "icon", "decoration"]
            },
            "accessibilityLabel": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "title", "role", "isEnabled"],
          "properties": {
            "type": { "const": "button" },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            },
            "title": { "type": "string" },
            "role": {
              "enum": ["standard", "primary", "destructive"]
            },
            "isEnabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "role"],
          "properties": {
            "type": { "const": "status" },
            "text": { "type": "string" },
            "role": {
              "enum": ["neutral", "positive", "warning", "negative"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "divider" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spacing"],
          "properties": {
            "type": { "const": "spacer" },
            "spacing": {
              "$ref": "#/$defs/spacing"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "flexibleSpacer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "axis", "spacing", "children"],
          "properties": {
            "type": { "const": "stack" },
            "axis": {
              "enum": ["horizontal", "vertical"]
            },
            "spacing": {
              "$ref": "#/$defs/spacing"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    },
    "spacing": {
      "enum": ["none", "tight", "small", "medium", "large"]
    },
    "customSurface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "shaderResource",
            "fragmentFunction",
            "preferredFramesPerSecond",
            "inputs"
          ],
          "properties": {
            "type": { "const": "metal" },
            "shaderResource": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/).+\\.metal$"
            },
            "fragmentFunction": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "preferredFramesPerSecond": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "inputs": {
              "type": "array",
              "maxItems": 8,
              "items": { "$ref": "#/$defs/surfaceInput" }
            }
          }
        }
      ]
    },
    "surfaceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "value": { "$ref": "#/$defs/surfaceScalar" }
      }
    },
    "surfaceScalar": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "constant" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "signal", "mapping"],
          "properties": {
            "type": { "const": "signal" },
            "signal": {
              "enum": ["active-account.usage-remaining"]
            },
            "mapping": { "$ref": "#/$defs/scalarMapping" }
          }
        }
      ]
    },
    "scalarMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputMinimum",
        "inputMaximum",
        "outputMinimum",
        "outputMaximum",
        "curve",
        "fallback"
      ],
      "properties": {
        "inputMinimum": { "type": "number" },
        "inputMaximum": { "type": "number" },
        "outputMinimum": { "type": "number" },
        "outputMaximum": { "type": "number" },
        "curve": {
          "enum": ["linear", "easeIn", "easeOut", "easeInOut"]
        },
        "fallback": { "type": "number" }
      }
    },
    "imageReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "identifier"],
          "properties": {
            "type": { "const": "hostAsset" },
            "identifier": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "extensionResource" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "systemSymbol" },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
