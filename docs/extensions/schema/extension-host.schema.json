{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.codes/schema/extension-host.schema.json",
  "title": "Threading extension host component publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "patches"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/patch" }
    }
  },
  "$defs": {
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "properties", "slots"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/propertyPatch" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slotPatch" }
        },
        "replacement": { "$ref": "extension-node.schema.json" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "contractVersion"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "contractVersion": { "type": "integer", "minimum": 1 },
        "entityID": { "type": "string", "minLength": 1 }
      }
    },
    "propertyPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/propertyValue" }
      }
    },
    "propertyValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "flag"],
          "properties": {
            "type": { "const": "flag" },
            "flag": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "image"],
          "properties": {
            "type": { "const": "image" },
            "image": { "$ref": "#/$defs/imageReference" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "identity"],
          "properties": {
            "type": { "const": "identity" },
            "identity": { "$ref": "#/$defs/identityComposition" }
          }
        }
      ]
    },
    "slotPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "children"],
      "properties": {
        "slot": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "extension-node.schema.json" }
        }
      }
    },
    "imageReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "identifier"],
          "properties": {
            "type": { "const": "hostAsset" },
            "identifier": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "extensionResource" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "systemSymbol" },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "identityComposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "image"],
          "properties": {
            "type": { "const": "image" },
            "image": { "$ref": "#/$defs/imageReference" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "base", "badge", "alignment"],
          "properties": {
            "type": { "const": "overlay" },
            "base": { "$ref": "#/$defs/identityComposition" },
            "badge": { "$ref": "#/$defs/identityComposition" },
            "alignment": {
              "enum": [
                "topLeading",
                "topTrailing",
                "bottomLeading",
                "bottomTrailing"
              ]
            }
          }
        }
      ]
    }
  }
}
