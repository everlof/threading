{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.codes/schema/extension-settings.schema.json",
  "title": "Threading extension settings contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages", "sections"],
  "properties": {
    "pages": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/page" }
    },
    "sections": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/hostSection" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "control"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "control": { "$ref": "#/$defs/control" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "control": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "defaultValue"],
          "properties": {
            "type": { "const": "toggle" },
            "defaultValue": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "defaultValue", "maximumLength"],
          "properties": {
            "type": { "const": "text" },
            "defaultValue": { "type": "string" },
            "placeholder": { "type": "string", "maxLength": 200 },
            "maximumLength": { "type": "integer", "minimum": 1, "maximum": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "defaultValue", "options"],
          "properties": {
            "type": { "const": "choice" },
            "defaultValue": { "$ref": "#/$defs/identifier" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/option" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "defaultValue", "minimum", "maximum", "step"],
          "properties": {
            "type": { "const": "integer" },
            "defaultValue": { "type": "integer" },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" },
            "step": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "symbol", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "hostSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "page", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "page": {
          "enum": [
            "general",
            "accounts",
            "profiles",
            "themes",
            "motion",
            "extensions",
            "tools",
            "keyboard",
            "usage",
            "storage",
            "archived"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    }
  }
}
