{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threading.codes/schema/workspace-navigator.schema.json",
  "title": "Threading workspace navigator contribution",
  "$ref": "#/$defs/navigator",
  "$defs": {
    "stableID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "contributionID": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "navigator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "root"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionID" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "root": { "$ref": "#/$defs/navigatorNode" },
        "loadActionID": { "$ref": "#/$defs/contributionID" },
        "preferredWidth": {
          "type": "number",
          "minimum": 180,
          "maximum": 640
        }
      }
    },
    "navigatorNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "content" },
            "content": { "$ref": "extension-node.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "collection"],
          "properties": {
            "type": { "const": "collection" },
            "collection": { "$ref": "#/$defs/collection" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "divider" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "spacing"],
          "properties": {
            "type": { "const": "spacer" },
            "spacing": {
              "enum": ["none", "tight", "small", "medium", "large"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "flexibleSpacer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "axis", "spacing", "children"],
          "properties": {
            "type": { "const": "stack" },
            "axis": { "enum": ["horizontal", "vertical"] },
            "spacing": {
              "enum": ["none", "tight", "small", "medium", "large"]
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/navigatorNode" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "base", "overlay"],
          "properties": {
            "type": { "const": "overlay" },
            "base": { "$ref": "#/$defs/navigatorNode" },
            "overlay": { "$ref": "#/$defs/navigatorNode" }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layout", "selectionMode", "sections", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/stableID" },
        "layout": { "$ref": "#/$defs/collectionLayout" },
        "selectionMode": { "enum": ["none", "single"] },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "collectionLayout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "list" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "outline" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "columns"],
          "properties": {
            "type": { "const": "grid" },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableID" },
        "header": { "$ref": "extension-node.schema.json" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "isEnabled", "isSelected", "isExpanded"],
      "properties": {
        "id": { "$ref": "#/$defs/stableID" },
        "sectionID": { "$ref": "#/$defs/stableID" },
        "parentID": { "$ref": "#/$defs/stableID" },
        "content": { "$ref": "extension-node.schema.json" },
        "accessibilityLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "activation": { "$ref": "#/$defs/activation" },
        "isEnabled": { "type": "boolean" },
        "isSelected": { "type": "boolean" },
        "isExpanded": { "type": "boolean" }
      }
    },
    "activation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "destination"],
          "properties": {
            "type": { "const": "destination" },
            "destination": { "$ref": "#/$defs/destination" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "action" },
            "id": { "$ref": "#/$defs/contributionID" }
          }
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "project" },
            "id": { "$ref": "#/$defs/stableID" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "session" },
            "id": { "$ref": "#/$defs/stableID" },
            "projectID": { "$ref": "#/$defs/stableID" }
          }
        }
      ]
    }
  }
}
