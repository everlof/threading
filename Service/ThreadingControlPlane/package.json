{
  "name": "threading-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:load": "THREADING_RENDEZVOUS_LOAD=1 vitest run test/rendezvous-load.test.ts",
    "dev": "wrangler dev",
    "preflight": "node scripts/preflight.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "deploy": "npm run preflight && npm run check && npm test && wrangler d1 migrations apply threading-control-plane --remote && wrangler deploy && npm run verify:production",
    "types": "wrangler types"
  },
  "dependencies": {
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@cloudflare/vitest-pool-workers": "0.21.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
