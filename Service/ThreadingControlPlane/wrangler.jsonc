{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threading-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "remote.threading.codes",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RENDEZVOUS",
        "class_name": "HostRendezvous"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HostRendezvous"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threading-control-plane",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ISSUE_REPORTS",
      "bucket_name": "threading-private-issue-reports"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "threading-issue-report-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "threading-issue-report-events-dlq",
        "max_concurrency": 2
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "934721001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "934721002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SOURCE_RATE_LIMITER",
      "namespace_id": "934721003",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "934721004",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "REPORT_GLOBAL_RATE_LIMITER",
      "namespace_id": "934721005",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "APPLE_CLIENT_IDS": "codes.threading,codes.threading.mobile",
    "APNS_TOPIC": "codes.threading.mobile",
    "ISSUE_REPORTS_BUCKET_NAME": "threading-private-issue-reports"
  },
  "secrets": {
    "required": [
      "SESSION_SIGNING_SECRET",
      "APPLE_TEAM_ID",
      "APPLE_KEY_ID",
      "APPLE_PRIVATE_KEY",
      "APPLE_TOKEN_ENCRYPTION_SECRET",
      "APNS_TEAM_ID",
      "APNS_KEY_ID",
      "APNS_PRIVATE_KEY",
      "TURN_KEY_ID",
      "TURN_KEY_API_TOKEN",
      "REPORT_PICKUP_TOKEN",
      "REPORT_ALERT_WEBHOOK_URL",
      "REPORT_ALERT_WEBHOOK_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  "triggers": {
    "crons": ["7,22,37,52 * * * *", "17 3 * * *"]
  }
}
