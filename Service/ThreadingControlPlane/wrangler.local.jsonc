{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threading-control-plane-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RENDEZVOUS",
        "class_name": "HostRendezvous"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HostRendezvous"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threading-control-plane-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ISSUE_REPORTS",
      "bucket_name": "threading-private-issue-reports-local"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "934722001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "934722002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "SOURCE_RATE_LIMITER",
      "namespace_id": "934722003",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "934722004",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "REPORT_GLOBAL_RATE_LIMITER",
      "namespace_id": "934722005",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "APPLE_CLIENT_IDS": "codes.threading,codes.threading.mobile",
    "APNS_TOPIC": "codes.threading.mobile",
    "ISSUE_REPORTS_BUCKET_NAME": "threading-private-issue-reports-local",
    "LOCAL_DEVELOPMENT_MODE": "1",
    "LOCAL_ICE_MODE": "host-only"
  },
  "observability": {
    "enabled": false
  }
}
