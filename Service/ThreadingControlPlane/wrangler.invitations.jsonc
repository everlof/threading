{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threading-invitations",
  "main": "src/invitation-worker.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "remote.threading.codes/join",
      "zone_name": "threading.codes"
    },
    {
      "pattern": "remote.threading.codes/.well-known/apple-app-site-association",
      "zone_name": "threading.codes"
    },
    {
      "pattern": "dev.remote.threading.codes/join",
      "zone_name": "threading.codes"
    },
    {
      "pattern": "dev.remote.threading.codes/.well-known/apple-app-site-association",
      "zone_name": "threading.codes"
    },
    {
      "pattern": "remote.threading.codes/join/*",
      "zone_name": "threading.codes"
    },
    {
      "pattern": "dev.remote.threading.codes/join/*",
      "zone_name": "threading.codes"
    }
  ],
  "assets": {
    "directory": ".wrangler/invitation-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
